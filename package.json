{
  "name": "redemption-story-bot",
  "version": "1.0.0",
  "description": "Redemption Story Studio - Discord bot central multi-serveur (Prison RP, Battle Royale, School RP, Shop) avec dashboard web.",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "setup": "tsx scripts/setup.ts",
    "deploy": "tsx scripts/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "discord",
    "bot",
    "fivem",
    "redemption-story"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.9",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
