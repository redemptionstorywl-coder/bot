# ───────────────────────────────────────────────
#  Redemption Story Studio — Discord Bot
#  Copiez ce fichier en `.env` puis remplissez-le.
# ───────────────────────────────────────────────

# ── Discord ───────────────────────────────────
# Token du bot (Developer Portal > Bot > Reset Token). NE JAMAIS LE PARTAGER.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
CLIENT_ID=
# Client Secret (Developer Portal > OAuth2) — requis pour le dashboard
DISCORD_CLIENT_SECRET=
# IDs Discord des propriétaires du bot (séparés par des virgules). Accès total au dashboard.
OWNER_IDS=
# Optionnel : serveur de développement pour déployer les commandes instantanément.
DEV_GUILD_ID=

# ── Base de données MySQL ─────────────────────
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL="mysql://root:password@localhost:3306/redemption_story"

# ── Dashboard ─────────────────────────────────
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
# Chaîne aléatoire longue (>= 32 caractères) pour signer les sessions
SESSION_SECRET=change-me-with-a-long-random-string

# ── API FiveM ─────────────────────────────────
# Clé partagée que les serveurs FiveM doivent envoyer dans l'en-tête `x-api-key`
FIVEM_API_KEY=change-me-fivem-api-key
# Secret du webhook Tebex (en-tête x-webhook-secret). Vide = FIVEM_API_KEY est utilisée.
TEBEX_WEBHOOK_SECRET=

# ── Traduction automatique FR → EN (optionnel) ──
# Active dans /config module:general ou Dashboard > Paramètres. Fournisseur utilisé, par ordre de priorité :
# 1. DeepL (meilleure qualité) : clé gratuite (500 000 caractères / mois) sur https://www.deepl.com/pro-api
#    Une clé « API Free » se termine par « :fx » (l'URL api-free.deepl.com est choisie automatiquement).
DEEPL_API_KEY=
# 2. Google Cloud Translation (API v2, clé d'API Google Cloud)
GOOGLE_TRANSLATE_API_KEY=
# 3. Sans clé : MyMemory gratuit (≈ 5 000 caractères / jour, 50 000 avec une adresse e-mail valide ci-dessous)
MYMEMORY_EMAIL=

# ── Divers ────────────────────────────────────
# development | production | test
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Fuseau horaire par défaut (dates affichées dans les embeds / scheduler)
TZ=Europe/Paris
# Migrations Prisma appliquées automatiquement au démarrage (`npm start` / `npm run dev`).
# RUN_MIGRATIONS=0 (ou SKIP_MIGRATIONS=1) les désactive, par ex. si elles sont lancées par la commande de build.
# RUN_MIGRATIONS=0
