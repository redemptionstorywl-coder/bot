<%
  const b = `/guilds/${guild.id}/events`;
  const isPolls = tab === 'polls';
  const moduleOff = isPolls
    ? (!modules.polls ? 'Le module Sondages est désactivé : les votes ne sont plus pris en compte.' : '')
    : (!modules.events ? 'Le module Événements est désactivé : inscriptions et rappels sont suspendus.' : '');
  const statusIcon = { SCHEDULED: 'clock', ONGOING: 'activity', ENDED: 'check-circle', CANCELLED: 'x-circle' };
  const sq = (s) => (s ? `${b}?status=${s}` : b);
%>
<%- include('../partials/events-header', { etab: isPolls ? 'polls' : 'events', counts, moduleOff }) %>

<% if (!isPolls) { %>
  <nav class="segmented mb-4" aria-label="Filtrer par statut">
    <a href="<%= sq('') %>"<%- !filters.status ? ' aria-current="page"' : '' %>>Tous</a>
    <% for (const s of Object.keys(statusLabels)) { %><a href="<%= sq(s) %>"<%- filters.status === s ? ' aria-current="page"' : '' %>><%= statusLabels[s] %><% if (statusCounts[s]) { %><span class="seg-count"><%= statusCounts[s] %></span><% } %></a><% } %>
  </nav>

  <section class="card card-flush" data-live-reload>
    <% if (!events.length) { %>
      <%- include('../partials/empty', filters.status
        ? { glyph: 'calendar', title: 'Aucun événement', text: 'Aucun événement avec ce statut.' }
        : { glyph: 'calendar', title: 'Aucun événement', text: 'Créez un événement : il est publié avec un bouton d’inscription et des rappels automatiques.', actionHref: b + '/new', actionLabel: 'Nouvel événement', actionIcon: 'plus' }) %>
    <% } else { %>
    <div class="table-wrap">
      <table class="table table-responsive table-clickable">
        <thead><tr><th>Événement</th><th>Statut</th><th>Début</th><th>Salon</th><th class="right">Participants</th></tr></thead>
        <tbody>
          <% for (const e of events) { const n = e.participants.length; %>
            <tr data-href="<%= b %>/<%= e.id %>">
              <td class="cell-primary"><div class="cell-stack"><a class="link strong truncate" href="<%= b %>/<%= e.id %>"><%= e.name %></a><span class="text-xs text-3 truncate"><%= e.location ? e.location + ' · ' : '' %>par <%= names[e.createdById] || e.createdById %></span></div></td>
              <td data-label="Statut"><span class="badge badge-status-<%= e.status %>"><%= statusLabels[e.status] %></span></td>
              <td data-label="Début" class="nowrap"><div class="cell-stack"><span><%= fmt.dateTime(e.startsAt) %></span><span class="text-xs text-3"><%= fmt.relative(e.startsAt) %></span></div></td>
              <td data-label="Salon"><span class="channel-tag"><%- icon('hash') %><%= channelName(e.channelId) %></span></td>
              <td data-label="Participants" class="right nowrap">
                <% if (e.maxParticipants) { %>
                  <span class="meter" title="<%= n %> / <%= e.maxParticipants %>"><span class="meter-track"><span class="bar-fill" data-pct="<%= Math.min(100, Math.round((n / e.maxParticipants) * 100)) %>"></span></span><span><%= n %>/<%= e.maxParticipants %></span></span>
                <% } else { %><%= n %><% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
<% } else { %>
  <section class="card card-flush" data-live-reload>
    <% if (!polls.length) { %>
      <%- include('../partials/empty', { glyph: 'bar-chart', title: 'Aucun sondage', text: 'Posez une question à votre communauté : résultats en direct, vote anonyme ou à choix multiples.', actionHref: b + '/polls/new', actionLabel: 'Nouveau sondage', actionIcon: 'plus' }) %>
    <% } else { %>
    <div class="table-wrap">
      <table class="table table-responsive table-clickable">
        <thead><tr><th>Question</th><th>Type</th><th>État</th><th>Fin</th><th class="right">Votants</th></tr></thead>
        <tbody>
          <% for (const p of polls) { %>
            <tr data-href="<%= b %>/polls/<%= p.id %>">
              <td class="cell-primary"><div class="cell-stack"><a class="link strong truncate" href="<%= b %>/polls/<%= p.id %>"><%= p.question %></a><span class="text-xs text-3 truncate"><%= p.optionList.map((o) => (o.emoji ? o.emoji + ' ' : '') + o.label).join(' · ') %></span></div></td>
              <td data-label="Type"><div class="row-wrap"><span class="badge badge-muted"><%= p.type === 'YES_NO' ? 'Oui / Non' : 'Choix' %></span><% if (p.multiSelect) { %><span class="badge badge-muted">Multi</span><% } %><% if (p.anonymous) { %><span class="badge badge-muted" data-tooltip="Votes anonymes"><%- icon('lock', { size: 12 }) %></span><% } %></div></td>
              <td data-label="État"><span class="badge <%= p.ended ? 'badge-status-ENDED' : 'badge-status-ONGOING' %>"><%= p.ended ? 'Terminé' : 'Ouvert' %></span></td>
              <td data-label="Fin" class="nowrap text-2"><%= p.endsAt ? (p.ended ? fmt.dateTime(p.endsAt) : fmt.relative(p.endsAt)) : '—' %></td>
              <td data-label="Votants" class="right"><%= fmt.number(p.voters) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
<% } %>
