<% const g = giveaway; const b = `/guilds/${guild.id}/giveaways`; %>
<a class="back-link" href="<%= b %>"><%- icon('arrow-left', { size: 16 }) %>Giveaways</a>
<header class="page-header">
  <div class="page-heading">
    <div><%- include('../partials/eyebrow') %>
      <h1 class="page-title row-wrap"><span><%= g.prize %></span><span class="badge <%= g.ended ? 'badge-status-ENDED' : 'badge-status-ONGOING' %>"><%= g.ended ? 'Terminé' : 'En cours' %></span></h1>
      <p class="page-subtitle">Organisé par <%= names[g.hostId] || g.hostId %> · #<%= channelName %> · <%= g.ended ? 'terminé' : 'fin' %> <%= fmt.relative(g.endsAt) %> (<%= fmt.dateTime(g.endsAt) %>)</p>
    </div>
  </div>
  <div class="page-actions">
    <% if (g.messageId) { %><a class="btn" href="https://discord.com/channels/<%= guild.id %>/<%= g.channelId %>/<%= g.messageId %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link', { size: 16 }) %>Voir sur Discord</a><% } %>
    <% if (!g.ended) { %>
      <form method="post" action="<%= b %>/<%= g.id %>/end" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-primary" data-confirm="Terminer maintenant et tirer les gagnants ?" data-confirm-label="Tirer au sort" data-confirm-variant="primary" <%= botReady ? '' : 'disabled' %>><%- icon('sparkles', { size: 16 }) %>Tirer maintenant</button></form>
      <form method="post" action="<%= b %>/<%= g.id %>/cancel" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Annuler ce giveaway sans gagnant ?" data-confirm-label="Annuler le giveaway"><%- icon('x-circle', { size: 16 }) %>Annuler</button></form>
    <% } %>
  </div>
</header>

<div class="split" data-live-reload>
  <div class="stack">
    <div class="stat-grid mb-0">
      <div class="stat"><span class="stat-label"><%- icon('users', { size: 14 }) %>Participants</span><span class="stat-value"><%= fmt.number(g.entries.length) %></span></div>
      <div class="stat"><span class="stat-label"><%- icon('crown', { size: 14 }) %>Gagnants</span><span class="stat-value"><%= winners.length %><span class="stat-sub">/ <%= g.winnersCount %></span></span></div>
      <div class="stat"><span class="stat-label"><%- icon('clock', { size: 14 }) %><%= g.ended ? 'Terminé' : 'Fin' %></span><span class="stat-value stat-value-sm"><%= fmt.relative(g.endsAt) %></span></div>
    </div>

    <section class="card">
      <div class="card-head"><div><h2 class="card-title">Gagnants</h2></div>
        <% if (g.ended) { %>
          <form method="post" action="<%= b %>/<%= g.id %>/reroll" class="row">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input name="count" type="number" class="input input-sm" min="1" max="50" value="1" aria-label="Nombre de gagnants à retirer" data-input-narrow>
            <button type="submit" class="btn btn-sm" data-confirm="Tirer de nouveaux gagnants ? Les gagnants précédents sont exclus." data-confirm-label="Relancer" data-confirm-variant="primary" <%= g.entries.length && botReady ? '' : 'disabled' %>><%- icon('refresh', { size: 14 }) %>Relancer</button>
          </form>
        <% } %>
      </div>
      <% if (!winners.length) { %>
        <p class="text-sm text-3"><%= g.ended ? 'Aucun gagnant (annulé ou aucun participant valide).' : 'Le tirage aura lieu à la fin du giveaway.' %></p>
      <% } else { %>
        <div class="chip-group"><% for (const id of winners) { %><a class="chip" href="/guilds/<%= guild.id %>/members/<%= id %>">🏆 <%= names[id] || id %></a><% } %></div>
      <% } %>
    </section>

    <section class="card">
      <div class="card-head"><div><h2 class="card-title">Participants</h2></div><span class="badge badge-muted"><%= g.entries.length %></span></div>
      <% if (!g.entries.length) { %>
        <p class="text-sm text-3">Aucun participant pour le moment.</p>
      <% } else { %>
        <% if (g.entries.length > 12) { %><label class="search mb-3"><%- icon('search', { size: 16 }) %><input type="search" class="input input-sm" placeholder="Rechercher un participant…" data-filter="#entries" aria-label="Rechercher un participant"></label><% } %>
        <div class="chip-group" id="entries"><% for (const e of g.entries) { %><a class="chip<%= winners.includes(e.userId) ? ' chip-on' : '' %>" data-filter-item href="/guilds/<%= guild.id %>/members/<%= e.userId %>" title="Inscrit le <%= fmt.dateTime(e.createdAt) %>"><% if (winners.includes(e.userId)) { %>🏆 <% } %><%= names[e.userId] || e.userId %></a><% } %></div>
      <% } %>
    </section>

    <section class="card">
      <h2 class="card-title">Conditions</h2>
      <dl class="dl">
        <dt>Rôle requis</dt><dd><%= roleName || '—' %></dd>
        <dt>Messages minimum</dt><dd><%= g.minMessages || '—' %></dd>
        <dt>Langue</dt><dd><%= g.language || config.defaultLanguage %></dd>
        <dt>Créé le</dt><dd><%= fmt.dateTime(g.createdAt) %></dd>
      </dl>
    </section>
  </div>

  <aside class="split-preview">
    <div class="preview-panel">
      <div class="preview-panel-head"><span class="row"><%- icon('eye', { size: 15 }) %>Message sur Discord</span><span class="badge badge-muted">#<%= channelName %></span></div>
      <div class="preview-panel-body"><%- previewHtml %></div>
    </div>
  </aside>
</div>
