<% const base = `/guilds/${guild.id}`; const at = typeof autoTranslate !== 'undefined' && autoTranslate ? autoTranslate : { enabled: false, layout: 'embed' }; %>
<header class="page-header"<%- scrollTo ? ` data-scroll-to="${scrollTo}"` : '' %>>
  <div class="page-heading">
    <div><%- include('../partials/eyebrow') %><h1 class="page-title">Paramètres</h1><p class="page-subtitle">Type de serveur, langue du bot, traduction automatique, apparence des messages, équipe et modules actifs.</p></div>
  </div>
</header>

<div class="with-toc">
  <nav class="toc" data-toc aria-label="Sommaire des paramètres">
    <div class="toc-title">Sur cette page</div>
    <a href="#type">Type de serveur</a>
    <a href="#langue">Langue et région</a>
    <a href="#traduction">Traduction automatique</a>
    <a href="#apparence">Apparence des embeds</a>
    <a href="#equipe">Équipe</a>
    <a href="#modules">Modules <span class="toc-meta" data-stat="modules-active"><%= modulesActive %></span></a>
    <a href="<%= base %>/permissions">Permissions des commandes <%- icon('arrow-right', { size: 14, cls: 'text-3' }) %></a>
  </nav>

  <div class="stack min-w-0">
    <form method="post" action="<%= base %>/settings" class="form stack" data-dirty-form id="settings-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <section class="card toc-section" id="type">
        <h2 class="card-title">Type de serveur</h2>
        <p class="card-desc mb-4">Active les modules recommandés pour ce type. Les modules déjà actifs le restent.</p>
        <div class="choice-grid" role="radiogroup" aria-label="Type de serveur">
          <% for (const k of kinds) { %>
            <label class="choice"><input type="radio" name="kind" value="<%= k.value %>" <%= config.kind === k.value ? 'checked' : '' %>><span><span class="choice-title"><%- icon(k.icon, { size: 15 }) %><%= k.label %></span><span class="choice-desc"><%= k.description %></span></span></label>
          <% } %>
        </div>
      </section>

      <section class="card toc-section" id="langue">
        <h2 class="card-title">Langue et région</h2>
        <div class="field-row mt-4">
          <div class="field">
            <span class="field-label" id="lang-label">Langue du bot</span>
            <div class="segmented" role="radiogroup" aria-labelledby="lang-label">
              <% for (const l of languages) { %><label><input type="radio" name="defaultLanguage" value="<%= l.code %>" <%= config.defaultLanguage === l.code ? 'checked' : '' %>><span><span class="lang-option" aria-hidden="true"><%= l.flag %></span><%= l.nativeLabel %></span></label><% } %>
            </div>
            <small class="hint">Langue des réponses, embeds et messages envoyés par le bot.</small>
          </div>
          <div class="field">
            <label for="timezone">Fuseau horaire</label>
            <input id="timezone" name="timezone" class="input" maxlength="64" value="<%= config.timezone %>" list="timezones" placeholder="Europe/Paris" autocomplete="off">
            <datalist id="timezones"><% for (const tz of timezones) { %><option value="<%= tz %>"></option><% } %></datalist>
            <small class="hint">Sert aux dates des événements, des annonces programmées et des graphiques.</small>
          </div>
        </div>
      </section>

      <section class="card toc-section" id="traduction">
        <div class="card-head">
          <div><h2 class="card-title">Traduction automatique en anglais</h2><p class="card-desc">Écrivez en français : le bot ajoute une version anglaise aux annonces, embeds (messages « comment jouer »…), messages de bienvenue et panneaux de tickets. Chaque message peut ensuite l'activer ou la couper avec son interrupteur « Version anglaise ».</p></div>
          <label class="toggle"><input type="checkbox" name="autoTranslate" <%= at.enabled ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Activée</span></label>
        </div>
        <div class="field">
          <span class="field-label" id="tr-layout-label">Mise en page de la version anglaise</span>
          <div class="segmented" role="radiogroup" aria-labelledby="tr-layout-label">
            <label><input type="radio" name="translateLayout" value="embed" <%= at.layout !== 'content' ? 'checked' : '' %>><span>🇫🇷 / 🇬🇧 Embed anglais séparé</span></label>
            <label><input type="radio" name="translateLayout" value="content" <%= at.layout === 'content' ? 'checked' : '' %>><span>🇬🇧 Texte à la suite</span></label>
          </div>
          <small class="hint">Embed séparé : l'embed français (marqué 🇫🇷) puis l'embed anglais (🇬🇧) dans le même message. Texte à la suite : la traduction est ajoutée sous une ligne « 🇬🇧 ───── », dans le texte ou dans l'embed (embed séparé si la place manque). Les messages texte sans embed reçoivent toujours la traduction à la suite.</small>
        </div>
        <div class="callout mt-4"><%- icon('info') %><div><strong>Fournisseur : <%= translateProvider.label %></strong> <span class="text-xs text-3"><%= translateProvider.endpoint %></span>
          <div class="text-sm text-2 mt-2"><% if (translateProvider.primary === 'mymemory') { %>Service gratuit sans clé, quota limité (≈ 5 000 caractères / jour<%= translateProvider.mymemoryEmail ? ', 50 000 avec MYMEMORY_EMAIL' : '' %>). Pour une meilleure qualité, créez une clé DeepL API Free (500 000 caractères / mois gratuits) et ajoutez-la dans <code>DEEPL_API_KEY</code> (fichier <code>.env</code>), puis redémarrez le bot.<% } else { %>Les traductions sont mises en cache : renvoyer ou modifier un message déjà traduit ne consomme pas de quota.<% } %> Si la traduction échoue, le message part en français seul.</div>
        </div></div>
      </section>

      <section class="card toc-section" id="apparence">
        <h2 class="card-title">Apparence des embeds</h2>
        <p class="card-desc mb-4">S'applique aux messages du bot qui ne définissent pas leur propre couleur ou pied de page.</p>
        <div class="settings-layout">
          <div class="min-w-0">
            <div class="field"><label for="brandColor">Couleur de marque</label><%- include('../partials/color-field', { name: 'brandColor', id: 'brandColor', value: fmt.hex(config.brandColor) }) %><small class="hint">Bande de couleur à gauche des embeds.</small></div>
            <div class="field"><label for="displayName">Nom affiché <span class="field-optional">optionnel</span></label><input id="displayName" name="displayName" class="input" maxlength="100" value="<%= settings && settings.displayName ? settings.displayName : '' %>" placeholder="<%= guild.name %>"><small class="hint">Remplace le nom du serveur dans les messages du bot.</small></div>
            <div class="field"><label for="footerText">Pied de page</label><input id="footerText" name="footerText" class="input" maxlength="200" value="<%= config.footerText || '' %>" placeholder="<%= brand.footer %>"><small class="hint">Texte discret affiché sous chaque embed.</small></div>
            <div class="field"><label for="footerIconUrl">Icône du pied de page <span class="field-optional">URL, optionnelle</span></label><input id="footerIconUrl" name="footerIconUrl" class="input" type="url" maxlength="500" value="<%= config.footerIconUrl || '' %>" placeholder="https://cdn.discordapp.com/…"></div>
          </div>
          <div class="preview-panel">
            <div class="preview-panel-head"><span class="row"><%- icon('eye', { size: 14 }) %>Aperçu Discord</span></div>
            <div class="preview-panel-body" data-settings-preview>
              <%- include('../partials/embed-preview', { embed: { title: 'Exemple d’annonce', description: 'Voici à quoi ressemblent les **embeds** envoyés par le bot sur *' + guild.name + '*.', footer: { text: config.footerText || brand.footer, iconUrl: config.footerIconUrl || undefined }, timestamp: true } }) %>
            </div>
          </div>
        </div>
      </section>

      <section class="card toc-section" id="equipe">
        <h2 class="card-title">Équipe</h2>
        <p class="card-desc mb-4">Les administrateurs règlent toute la configuration (<code>/config</code>) ; le staff gère la modération, les tickets et la whitelist. Pour autoriser un rôle sur une commande précise, utilisez <a class="link" href="<%= base %>/permissions">Permissions</a>.</p>
        <div class="field-row">
          <div class="field"><label for="adminRoleIds">Rôles administrateurs</label><%- include('../partials/role-select', { name: 'adminRoleIds', id: 'adminRoleIds', selected: config.adminRoleIds }) %><small class="hint">Le propriétaire du serveur et les membres « Administrateur » Discord le sont toujours.</small></div>
          <div class="field"><label for="staffRoleIds">Rôles staff</label><%- include('../partials/role-select', { name: 'staffRoleIds', id: 'staffRoleIds', selected: config.staffRoleIds }) %><small class="hint">Modérateurs, support et équipe whitelist.</small></div>
        </div>
      </section>

      <div class="form-actions dirty-hide"><button type="submit" class="btn btn-primary">Enregistrer les paramètres</button></div>
    </form>

    <section class="card toc-section" id="modules">
      <div class="card-head">
        <div><h2 class="card-title">Modules</h2><p class="card-desc">Un module coupé ignore ses commandes et ses boutons (les membres reçoivent un message clair). Chaque changement s'applique immédiatement.</p></div>
        <span class="badge badge-accent"><span data-stat="modules-active"><%= modulesActive %></span> / <%= modulesTotal %> actifs</span>
      </div>
      <% for (const grp of moduleGroups) { %>
        <div class="module-group">
          <h3 class="module-group-title"><%= grp.label %></h3>
          <div class="module-grid">
            <% for (const m of grp.modules) { %>
              <article class="module-card<%= m.enabled ? ' is-on' : '' %>" data-module-card="<%= m.key %>">
                <span class="module-card-icon"><%- icon(m.icon) %></span>
                <span class="module-card-title"><%= m.label %></span>
                <label class="toggle"><input type="checkbox" data-module-toggle="<%= m.key %>" data-label="<%= m.label %>" data-url="<%= base %>/modules/<%= m.key %>" <%= m.enabled ? 'checked' : '' %> aria-label="Activer le module <%= m.label %>"><span class="toggle-track"></span></label>
                <p class="module-card-desc"><%= m.description %></p>
                <div class="module-card-foot"><span class="module-state-label" data-module-state><%= m.enabled ? 'Activé' : 'Désactivé' %></span><% if (m.path) { %><a class="link text-xs" href="<%= base %>/<%= m.path %>">Configurer</a><% } %></div>
              </article>
            <% } %>
          </div>
        </div>
      <% } %>
    </section>
  </div>
</div>
