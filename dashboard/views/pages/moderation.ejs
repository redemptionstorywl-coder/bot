<%
  const base = `/guilds/${guild.id}/moderation`;
  const ar = antiRaid; const an = ar.antiNuke;
  const minutes = (s) => Math.max(1, Math.round((s || 0) / 60));
  const person = (id) => profiles[id];
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const userCell = (id) => { if (!id) return '<span class="text-3">—</span>'; const p = person(id); return `<a class="user-cell" href="/guilds/${guild.id}/members/${esc(id)}">${p ? `<img class="avatar avatar-xs" src="${esc(p.avatarUrl)}" alt="">` : ''}<span class="truncate">${esc(p ? p.name : id)}</span></a>`; };
  const subHead = (name, checked, target, title, desc, iconName) => `<div class="card-head mb-3"><div><h3 class="subcard-title mb-0">${icon(iconName, { size: 16 })}${title}</h3>${desc ? `<p class="card-desc">${desc}</p>` : ''}</div><label class="toggle"><input type="checkbox" name="${name}" ${checked ? 'checked' : ''} data-check-toggle="${target}"><span class="toggle-track"></span><span class="sr-only">Activer : ${title}</span></label></div>`;
  const activeProtections = [an.enabled, ar.antiSpam.enabled, ar.antiMassMention.enabled, ar.antiLink.enabled, ar.antiNewAccount.enabled, ar.antiBot.enabled, ar.antiMassJoin.enabled].filter(Boolean).length;
  /** Gravité affichée : rouge réservé aux sanctions lourdes (exclusion du serveur), ambre pour les avertissements. */
  const sevClass = (t) => ['BAN', 'TEMPBAN', 'KICK', 'LOCKDOWN'].includes(t) ? 'badge-danger' : negativeTypes.includes(t) ? 'badge-warning' : 'badge-muted';
  const job = massUnban.job;
  const jobRunning = Boolean(job && !job.finishedAt);
%>
<header class="page-header"<%- scrollTo ? ` data-scroll-to="${scrollTo}"` : '' %>>
  <div class="page-heading">
    <div><%- include('../partials/eyebrow') %><h1 class="page-title">Modération</h1><p class="page-subtitle">Sanctions et avertissements, protections automatiques, lockdown et actions sensibles.</p></div>
  </div>
  <div class="page-actions">
    <% if (modConfig.lockdownActive) { %><a class="btn btn-danger" href="<%= base %>?tab=lockdown"><%- icon('lock', { size: 16 }) %>Lockdown actif</a><% } %>
  </div>
</header>

<% if (!modules.moderation) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Modération est désactivé : les commandes de sanction ne répondent pas. <a class="link" href="/guilds/<%= guild.id %>/settings#modules">Activer le module</a></span></div><% } %>

<section class="stat-grid" aria-label="Résumé de la modération">
  <a class="stat" href="<%= base %>?tab=stats"><span class="stat-label">Sanctions (30 j)</span><strong class="stat-value"><%= fmt.number(stats.total) %></strong><span class="stat-sub">tous types confondus</span></a>
  <a class="stat" href="<%= base %>?tab=warnings"><span class="stat-label">Avertissements actifs</span><strong class="stat-value" data-stat="activeWarnings"><%= fmt.number(stats.activeWarnings) %></strong><span class="stat-sub">comptent pour l'escalade</span></a>
  <div class="stat"><span class="stat-label">Bans temporaires</span><strong class="stat-value"><%= fmt.number(stats.activeBans) %></strong><span class="stat-sub"><%= fmt.number(stats.activeMutes) %> mute(s) en cours</span></div>
  <a class="stat<%= modules.antiraid && activeProtections ? '' : ' is-warn' %>" href="<%= base %>?tab=antiraid"><span class="stat-label">Protections</span><strong class="stat-value"><%= activeProtections %><span class="stat-sub">/ 7 actives</span></strong><span class="stat-sub"><%= modules.antiraid ? 'module anti-raid actif' : 'module anti-raid coupé' %></span></a>
</section>

<%- include('../partials/tabs', { active: view, label: 'Sections de la modération', tabs: [
  { key: 'sanctions', label: 'Sanctions', href: base, icon: 'list', count: view === 'sanctions' ? fmt.number(pagination.total) : null },
  { key: 'warnings', label: 'Avertissements', href: base + '?tab=warnings', icon: 'alert-triangle' },
  { key: 'protection', label: 'Protection', href: base + '?tab=protection', icon: 'shield-check', count: modConfig.lockdownActive ? 'lockdown' : activeProtections + '/7' },
] }) %>

<% if (view === 'sanctions') { %>
  <form method="get" action="<%= base %>" class="row-wrap mb-4">
    <input type="hidden" name="tab" value="sanctions">
    <select name="type" class="select select-sm" aria-label="Type de sanction" data-submit-on-change><option value="">Tous les types</option><% for (const t of sanctionTypes) { %><option value="<%= t.value %>" <%= filters.type === t.value ? 'selected' : '' %>><%= t.label %></option><% } %></select>
    <label class="search"><%- icon('search', { size: 16 }) %><input name="user" class="input input-sm input-mono" value="<%= filters.user || '' %>" pattern="^\d{15,22}$" placeholder="ID du membre" aria-label="ID du membre"></label>
    <button type="submit" class="btn btn-sm">Filtrer</button>
    <% if (filters.type || filters.user) { %><a class="btn btn-ghost btn-sm" href="<%= base %>">Effacer les filtres</a><% } %>
  </form>
  <div class="<%= selectedCase ? 'grid-aside-right grid-2' : '' %>">
    <section class="card card-flush" data-live-reload>
      <% if (!sanctions.length) { %>
        <%- include('../partials/empty', { glyph: 'shield-check', title: 'Aucune sanction', text: filters.type || filters.user ? 'Aucune sanction ne correspond à ces filtres.' : 'Les sanctions prononcées par le staff ou le bot apparaîtront ici.' }) %>
      <% } else { %>
      <div class="table-wrap"><table class="table table-responsive table-clickable">
        <thead><tr><th>Cas</th><th>Type</th><th>Membre</th><th>Modérateur</th><th>Raison</th><th>Date</th></tr></thead>
        <tbody>
          <% for (const s of sanctions) { %>
            <tr data-href="<%= base %>?<%= baseQuery %>&case=<%= s.caseNumber %>"<%- selectedCase && selectedCase.caseNumber === s.caseNumber ? ' class="is-selected"' : '' %>>
              <td class="cell-primary"><a class="mono" href="<%= base %>?<%= baseQuery %>&case=<%= s.caseNumber %>">#<%= s.caseNumber %></a></td>
              <td data-label="Type"><span class="badge <%= sevClass(s.type) %>"><%= typeLabels[s.type] %></span><% if (s.duration) { %> <span class="text-3 text-xs"><%= fmt.duration(s.duration) %></span><% } %></td>
              <td data-label="Membre"><%- userCell(s.userId) %></td>
              <td data-label="Modérateur"><%- userCell(s.moderatorId) %></td>
              <td data-label="Raison" class="text-2"><%= fmt.truncate(s.reason, 60) || '—' %></td>
              <td data-label="Date" class="nowrap" title="<%= fmt.dateTime(s.createdAt) %>"><%= fmt.relative(s.createdAt) %></td>
            </tr>
          <% } %>
        </tbody>
      </table></div>
      <% } %>
    </section>
    <% if (selectedCase) { %>
    <aside class="card sheet">
      <div class="card-head"><h2 class="card-title">Cas #<%= selectedCase.caseNumber %></h2><a class="icon-btn" href="<%= base %>?<%= baseQuery %>" aria-label="Fermer la fiche"><%- icon('x') %></a></div>
      <span class="badge badge-lg <%= sevClass(selectedCase.type) %>"><%= typeLabels[selectedCase.type] %></span>
      <dl class="dl mt-4">
        <dt>Membre</dt><dd><%- userCell(selectedCase.userId) %></dd>
        <dt>Modérateur</dt><dd><%- userCell(selectedCase.moderatorId) %></dd>
        <dt>Date</dt><dd><%= fmt.dateTime(selectedCase.createdAt) %></dd>
        <dt>Durée</dt><dd><%= selectedCase.duration ? fmt.duration(selectedCase.duration) : '—' %></dd>
        <dt>Salon</dt><dd><%= selectedCase.channelId ? '#' + ((guild.textChannels.find((c) => c.id === selectedCase.channelId) || { name: selectedCase.channelId }).name) : '—' %></dd>
        <dt>Raison</dt><dd><%= selectedCase.reason || '—' %></dd>
      </dl>
      <% if (selectedCase.metadata) { %><details class="editor-section mt-4 mb-0"><summary>Détails techniques</summary><pre class="json"><%= fmt.json(selectedCase.metadata) %></pre></details><% } %>
    </aside>
    <% } %>
  </div>
  <%- include('../partials/pagination', { pagination, baseQuery, baseUrl: base }) %>

  <section class="card mt-5 toc-section" id="stats" aria-label="Statistiques">
    <%- include('../partials/chart-hbars', { chart: statsChart, title: 'Sanctions des 30 derniers jours', sub: 'Par type, toutes sanctions confondues (bot et staff).', emptyText: 'Aucune sanction sur la période.', unit: 'Sanctions' }) %>
  </section>

<% } else if (view === 'warnings') { %>
  <form method="get" action="<%= base %>" class="row mb-5" role="search">
    <input type="hidden" name="tab" value="warnings">
    <label class="search grow"><%- icon('search', { size: 16 }) %><input name="warnUser" class="input input-mono" value="<%= filters.warnUser || '' %>" required pattern="^\d{15,22}$" placeholder="ID Discord du membre (clic droit → Copier l'identifiant)" aria-label="ID du membre"></label>
    <button type="submit" class="btn btn-primary">Rechercher</button>
  </form>
  <% if (!filters.warnUser) { %>
    <%- include('../partials/empty', { glyph: 'alert-triangle', title: 'Consulter les avertissements d’un membre', text: 'Saisissez son identifiant Discord, ou ouvrez sa fiche depuis la page Membres.' }) %>
  <% } else { const active = warnings.filter((w) => w.active).length; %>
  <section class="card card-flush">
    <div class="card-head">
      <div class="row-3"><%- userCell(filters.warnUser) %><span class="badge <%= active ? 'badge-warning' : 'badge-muted' %>"><%= active %> actif(s)</span></div>
      <% if (active) { %>
      <form method="post" action="<%= base %>/warnings/clear" class="row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= filters.warnUser %>"><input name="reason" class="input input-sm" maxlength="300" placeholder="Raison (optionnelle)" aria-label="Raison"><button type="submit" class="btn btn-danger btn-sm" data-confirm="Effacer tous les avertissements actifs de ce membre ?" data-confirm-title="Tout effacer" data-confirm-label="Effacer">Tout effacer</button></form>
      <% } %>
    </div>
    <% if (!warnings.length) { %><%- include('../partials/empty', { glyph: 'check-circle', title: 'Aucun avertissement', compact: true }) %><% } else { %>
    <ul class="list">
      <% for (const w of warnings) { %>
        <li class="list-item<%= w.active ? '' : ' row-disabled' %>">
          <span class="list-item-icon"><%- icon('alert-triangle') %></span>
          <div class="list-item-body"><div class="list-item-title"><%= w.reason %></div><div class="list-item-meta">#<%= w.id %> · par <%= (person(w.moderatorId) || {}).name || w.moderatorId %> · <%= fmt.dateTime(w.createdAt) %></div></div>
          <span class="badge <%= w.active ? 'badge-warning' : 'badge-muted' %>"><%= w.active ? 'actif' : 'levé' %></span>
          <% if (w.active) { %><form method="post" action="<%= base %>/warnings/<%= w.id %>/remove" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= w.userId %>"><button type="submit" class="btn btn-ghost btn-sm" data-confirm="Retirer l'avertissement #<%= w.id %> ?" data-confirm-label="Retirer">Retirer</button></form><% } %>
        </li>
      <% } %>
    </ul>
    <% } %>
  </section>
  <% } %>

<% } else { %>
<div class="with-toc">
  <nav class="toc" data-toc aria-label="Sections de la protection">
    <div class="toc-title">Protection</div>
    <a href="#lockdown">Lockdown<% if (modConfig.lockdownActive) { %><span class="toc-meta">actif</span><% } %></a>
    <a href="#anti-nuke">Anti-nuke<span class="toc-meta"><%= an.enabled ? 'on' : 'off' %></span></a>
    <a href="#filtres">Filtres automatiques</a>
    <a href="#exemptions">Exemptions</a>
    <a href="#escalade">Escalade des avertissements<span class="toc-meta"><%= modConfig.warnThresholds.length || '' %></span></a>
    <a href="#salon-piege">Salon piège<span class="toc-meta"><%= honeypot ? (honeypot.enabled ? 'on' : 'off') : '' %></span></a>
    <a href="#danger-zone">Actions sensibles</a>
  </nav>

  <div class="stack min-w-0">
    <% if (!modules.antiraid) { %><div class="alert alert-warning mb-0"><%- icon('alert-triangle') %><span class="alert-text">Le module Anti-raid est désactivé : les protections ci-dessous ne s'appliquent pas. <a class="link" href="/guilds/<%= guild.id %>/settings#modules">Activer le module</a></span></div><% } %>

    <section class="card toc-section" id="lockdown">
      <h2 class="card-title">Lockdown</h2>
      <div class="lockdown-state <%= modConfig.lockdownActive ? 'on' : '' %>">
        <span class="page-icon"><%- icon(modConfig.lockdownActive ? 'lock' : 'unlock') %></span>
        <div class="grow">
          <strong><%= modConfig.lockdownActive ? 'Lockdown actif' : 'Serveur ouvert' %></strong>
          <% if (modConfig.lockdownActive && modConfig.lockdownState) { %><p class="text-sm text-2 mb-0">Depuis le <%= fmt.dateTime(modConfig.lockdownState.at) %> par <%= names[modConfig.lockdownState.actorId] || modConfig.lockdownState.actorId %> · <%= Object.keys(modConfig.lockdownState.channels).length %> salon(s) verrouillé(s)<%= modConfig.lockdownState.reason ? ' · ' + modConfig.lockdownState.reason : '' %></p><% } else { %><p class="text-sm text-2 mb-0">Le lockdown retire à @everyone le droit d'écrire dans tous les salons texte, puis restaure l'état précédent à la levée.</p><% } %>
        </div>
      </div>
      <% if (!botReady) { %><div class="alert alert-warning mt-4 mb-0"><%- icon('alert-triangle') %><span class="alert-text">Le bot n'est pas connecté : le lockdown ne peut pas être modifié pour le moment.</span></div><% } %>
      <form method="post" action="<%= base %>/lockdown" class="row-wrap mt-4" data-confirm="<%= modConfig.lockdownActive ? 'Lever le lockdown et restaurer les permissions ?' : 'Activer le lockdown : plus personne (hors staff) ne pourra écrire ?' %>" data-confirm-title="<%= modConfig.lockdownActive ? 'Lever le lockdown' : 'Activer le lockdown' %>" data-confirm-label="Confirmer" <%- modConfig.lockdownActive ? 'data-confirm-variant="primary"' : '' %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (!modConfig.lockdownActive) { %><input type="hidden" name="enabled" value="on"><% } %>
        <input id="ld-reason" name="reason" class="input grow" maxlength="300" placeholder="Raison (optionnelle), ex. raid en cours" aria-label="Raison du lockdown">
        <button type="submit" class="btn <%= modConfig.lockdownActive ? 'btn-primary' : 'btn-danger' %>" <%= botReady ? '' : 'disabled' %>><%- icon(modConfig.lockdownActive ? 'unlock' : 'lock', { size: 16 }) %><%= modConfig.lockdownActive ? 'Lever le lockdown' : 'Activer le lockdown' %></button>
      </form>
    </section>

    <form method="post" action="<%= base %>/antiraid" class="form stack" data-dirty-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <section class="card card-accent toc-section" id="anti-nuke">
        <div class="card-head"><div><h2 class="card-title"><%- icon('shield-alert') %>Anti-nuke</h2><p class="card-desc">Protège contre un compte compromis ou une application malveillante : l'auteur qui dépasse un seuil est puni immédiatement.</p></div><label class="toggle"><input type="checkbox" name="antiNukeEnabled" <%= an.enabled ? 'checked' : '' %> data-check-toggle="#nk-opts"><span class="toggle-track"></span><span class="toggle-label">Actif</span></label></div>
        <div id="nk-opts" class="stack-4">
          <div class="field"><span class="field-label" id="nk-pun">Punition de l'auteur <span class="field-optional">un bot est toujours banni</span></span>
            <div class="segmented" role="radiogroup" aria-labelledby="nk-pun">
              <label><input type="radio" name="antiNukePunishment" value="STRIP_ROLES" <%= an.punishment === 'STRIP_ROLES' ? 'checked' : '' %>><span>Retirer les rôles dangereux</span></label>
              <label><input type="radio" name="antiNukePunishment" value="KICK" <%= an.punishment === 'KICK' ? 'checked' : '' %>><span>Expulser</span></label>
              <label><input type="radio" name="antiNukePunishment" value="BAN" <%= an.punishment === 'BAN' ? 'checked' : '' %>><span>Bannir</span></label>
            </div>
          </div>
          <div class="choice-grid">
            <% for (const [n, v, t, d] of [
              ['antiNukeBotAdd', an.botAddProtection, 'Ajouts de bots', 'Expulse tout bot ajouté par un membre non exempté.'],
              ['antiNukeLockdown', an.lockdownOnTrigger, 'Lockdown automatique', 'Verrouille le serveur au déclenchement.'],
              ['antiNukeRestoreBans', an.restoreBans, 'Rétablir les bans', 'Annule les bans faits par l’auteur.'],
              ['antiNukeDm', an.dmExecutor, 'Prévenir l’auteur', 'Message privé à la personne sanctionnée.'],
              ['antiNukeExemptTeam', an.exemptTeamRoles, 'Exempter l’équipe', 'Rôles admin et staff exemptés (déconseillé).'],
            ]) { %>
              <label class="choice"><input type="checkbox" name="<%= n %>" <%= v ? 'checked' : '' %>><span><span class="choice-title"><%= t %></span><span class="choice-desc"><%= d %></span></span></label>
            <% } %>
          </div>
          <div class="field"><label for="nk-wl">Utilisateurs de confiance <span class="field-optional">IDs séparés par des espaces</span></label><textarea id="nk-wl" name="antiNukeWhitelist" class="textarea textarea-sm input-mono" rows="2" placeholder="123456789012345678"><%= an.whitelistUserIds.join(' ') %></textarea><small class="hint">Toujours exemptés : propriétaire du serveur, propriétaires du bot et le bot lui-même.</small></div>
          <div class="table-wrap">
            <table class="table table-compact">
              <thead><tr><th>Action surveillée</th><th class="shrink">Maximum</th><th class="shrink">Fenêtre (s)</th></tr></thead>
              <tbody>
                <% for (const a of antiNukeActions) { const th = an.thresholds[a.key]; %>
                  <tr><td><label for="nk-<%= a.key %>-max"><%= a.label %></label></td><td class="shrink"><input id="nk-<%= a.key %>-max" name="antiNuke_<%= a.key %>_max" type="number" class="input input-sm" min="1" max="100" value="<%= th.max %>" aria-label="<%= a.label %> : maximum"></td><td class="shrink"><input name="antiNuke_<%= a.key %>_seconds" type="number" class="input input-sm" min="1" max="600" value="<%= th.intervalSeconds %>" aria-label="<%= a.label %> : fenêtre en secondes"></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="card toc-section" id="filtres">
        <h2 class="card-title">Filtres automatiques</h2>
        <p class="card-desc mb-4">Chaque filtre s'active séparément. Le staff n'est jamais concerné par les filtres de messages.</p>
        <div class="grid-2 mb-0">
          <div class="subcard">
            <%- subHead('antiSpamEnabled', ar.antiSpam.enabled, '#as-opts', 'Anti-spam', 'Trop de messages en peu de temps.', 'message-square') %>
            <div id="as-opts" class="field-row">
              <div class="field"><label for="as-max">Messages max</label><input id="as-max" name="antiSpamMaxMessages" type="number" class="input" min="2" max="50" value="<%= ar.antiSpam.maxMessages %>"></div>
              <div class="field"><label for="as-int">En (secondes)</label><input id="as-int" name="antiSpamIntervalSeconds" type="number" class="input" min="1" max="120" value="<%= ar.antiSpam.intervalSeconds %>"></div>
              <div class="field"><label for="as-to">Exclusion (min)</label><input id="as-to" name="antiSpamTimeoutMinutes" type="number" class="input" min="1" max="40320" value="<%= minutes(ar.antiSpam.timeoutSeconds) %>"></div>
            </div>
          </div>
          <div class="subcard">
            <%- subHead('antiMassMentionEnabled', ar.antiMassMention.enabled, '#am-opts', 'Mentions de masse', 'Trop de mentions dans un message.', 'users') %>
            <div id="am-opts" class="field-row">
              <div class="field"><label for="am-max">Mentions max</label><input id="am-max" name="antiMassMentionMax" type="number" class="input" min="2" max="100" value="<%= ar.antiMassMention.maxMentions %>"></div>
              <div class="field"><label for="am-to">Exclusion (min)</label><input id="am-to" name="antiMassMentionTimeoutMinutes" type="number" class="input" min="1" max="40320" value="<%= minutes(ar.antiMassMention.timeoutSeconds) %>"></div>
            </div>
          </div>
          <div class="subcard">
            <%- subHead('antiLinkEnabled', ar.antiLink.enabled, '#al-opts', 'Liens et invitations', 'Invitations Discord et liens non autorisés.', 'link') %>
            <div id="al-opts" class="stack-4">
              <div class="stack-2">
                <label class="toggle toggle-sm"><input type="checkbox" name="antiLinkBlockInvites" <%= ar.antiLink.blockInvites ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Bloquer les invitations Discord</span></label>
                <label class="toggle toggle-sm"><input type="checkbox" name="antiLinkBlockLinks" <%= ar.antiLink.blockLinks ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Bloquer tous les liens hors liste blanche</span></label>
              </div>
              <div class="field"><label for="al-wl">Domaines autorisés <span class="field-optional">un par ligne</span></label><textarea id="al-wl" name="antiLinkWhitelist" class="textarea textarea-sm input-mono" rows="3" placeholder="youtube.com&#10;redemption-story.fr"><%= ar.antiLink.whitelistDomains.join('\n') %></textarea></div>
              <div class="field-row">
                <div class="field"><span class="field-label">Action</span><div class="segmented"><label><input type="radio" name="antiLinkAction" value="DELETE" <%= ar.antiLink.action === 'DELETE' ? 'checked' : '' %>><span>Supprimer</span></label><label><input type="radio" name="antiLinkAction" value="TIMEOUT" <%= ar.antiLink.action === 'TIMEOUT' ? 'checked' : '' %>><span>Supprimer + exclure</span></label></div></div>
                <div class="field"><label for="al-to">Exclusion (min)</label><input id="al-to" name="antiLinkTimeoutMinutes" type="number" class="input" min="1" max="40320" value="<%= minutes(ar.antiLink.timeoutSeconds) %>"></div>
              </div>
            </div>
          </div>
          <div class="subcard">
            <%- subHead('antiNewAccountEnabled', ar.antiNewAccount.enabled, '#an-opts', 'Comptes récents', 'Comptes Discord créés récemment.', 'user-x') %>
            <div id="an-opts" class="stack-4">
              <div class="field-row">
                <div class="field"><label for="an-age">Âge minimal (jours)</label><input id="an-age" name="antiNewAccountMinAgeDays" type="number" class="input" min="1" max="365" value="<%= ar.antiNewAccount.minAgeDays %>"></div>
                <div class="field"><span class="field-label">Action</span><div class="segmented"><label><input type="radio" name="antiNewAccountAction" value="KICK" <%= ar.antiNewAccount.action === 'KICK' ? 'checked' : '' %>><span>Expulser</span></label><label><input type="radio" name="antiNewAccountAction" value="QUARANTINE" <%= ar.antiNewAccount.action === 'QUARANTINE' ? 'checked' : '' %>><span>Quarantaine</span></label></div></div>
              </div>
              <div class="field"><label for="an-role">Rôle de quarantaine</label><%- include('../partials/role-select', { name: 'antiNewAccountQuarantineRoleId', id: 'an-role', selected: ar.antiNewAccount.quarantineRoleId || '', multiple: false }) %><small class="hint">Obligatoire pour l'action « Quarantaine ».</small></div>
            </div>
          </div>
          <div class="subcard">
            <%- subHead('antiBotEnabled', ar.antiBot.enabled, '#ab-opts', 'Bots non autorisés', 'Expulse les bots ajoutés sans autorisation.', 'bot') %>
            <div id="ab-opts" class="field"><label for="ab-ids">Bots autorisés <span class="field-optional">IDs séparés par des espaces</span></label><textarea id="ab-ids" name="antiBotAllowedIds" class="textarea textarea-sm input-mono" rows="2"><%= ar.antiBot.allowedBotIds.join(' ') %></textarea></div>
          </div>
          <div class="subcard">
            <%- subHead('antiMassJoinEnabled', ar.antiMassJoin.enabled, '#aj-opts', 'Arrivées massives', 'Vague d’arrivées en peu de temps.', 'user-plus') %>
            <div id="aj-opts" class="stack-4">
              <div class="field-row">
                <div class="field"><label for="aj-max">Arrivées max</label><input id="aj-max" name="antiMassJoinMax" type="number" class="input" min="2" max="500" value="<%= ar.antiMassJoin.maxJoins %>"></div>
                <div class="field"><label for="aj-int">En (secondes)</label><input id="aj-int" name="antiMassJoinIntervalSeconds" type="number" class="input" min="1" max="600" value="<%= ar.antiMassJoin.intervalSeconds %>"></div>
              </div>
              <label class="toggle toggle-sm"><input type="checkbox" name="antiMassJoinLockdown" <%= ar.antiMassJoin.lockdown ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Déclencher automatiquement le lockdown</span></label>
            </div>
          </div>
        </div>
      </section>

      <section class="card toc-section" id="exemptions">
        <h2 class="card-title"><%- icon('user-check') %>Exemptions</h2>
        <p class="card-desc mb-4">Le staff est toujours exempté des filtres de messages (spam, mentions, liens).</p>
        <div class="field-row">
          <div class="field"><label for="ex-roles">Rôles exemptés</label><%- include('../partials/role-select', { name: 'exemptRoleIds', id: 'ex-roles', selected: ar.exemptRoleIds }) %></div>
          <div class="field"><label for="ex-channels">Salons exemptés</label>
            <select id="ex-channels" name="exemptChannelIds" class="select" multiple data-channel-picker data-placeholder="Ajouter des salons…">
              <% for (const c of guild.textChannels) { %><option value="<%= c.id %>" data-type="<%= c.type %>" data-name="<%= c.name %>" <%= ar.exemptChannelIds.includes(c.id) ? 'selected' : '' %>># <%= c.name %></option><% } %>
            </select>
          </div>
        </div>
        <div class="form-footer dirty-hide"><button type="submit" class="btn btn-primary">Enregistrer les protections</button></div>
      </section>
    </form>

    <form method="post" action="<%= base %>/config" class="form" data-dirty-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <section class="card toc-section" id="escalade">
        <h2 class="card-title"><%- icon('zap') %>Escalade automatique</h2>
        <p class="card-desc mb-4">Action appliquée quand le nombre d'avertissements actifs d'un membre atteint un seuil.</p>
        <%- include('../partials/repeater', { kind: 'threshold', rows: modConfig.warnThresholds, name: 'thresholdsJson', id: 'thresholds-json', max: 25, addLabel: 'Ajouter un seuil' }) %>
        <div class="field-row mt-5">
          <div class="field"><label for="m-mute">Rôle mute <span class="field-optional">pour /mute</span></label><%- include('../partials/role-select', { name: 'muteRoleId', id: 'm-mute', selected: modConfig.muteRoleId || '', multiple: false, emptyLabel: 'Aucun (exclusion Discord uniquement)', placeholder: 'Aucun (exclusion Discord uniquement)' }) %></div>
          <div class="field"><span class="field-label">Message au membre</span><label class="toggle"><input type="checkbox" name="dmOnSanction" <%= modConfig.dmOnSanction ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Prévenir en message privé à chaque sanction</span></label></div>
        </div>
        <div class="form-footer dirty-hide"><button type="submit" class="btn btn-primary">Enregistrer l'escalade</button></div>
      </section>
    </form>

    <section class="card toc-section" id="salon-piege">
      <h2 class="card-title"><%- icon('ban') %>Salon piège</h2>
      <p class="card-desc mb-4">Un salon visible par tous affiche un avertissement épinglé. Les comptes piratés et les bots de spam écrivent partout : dès qu'un membre <strong>hors staff</strong> y poste, ses messages récents sont supprimés et il est <strong>expulsé</strong>.</p>
      <div class="split">
        <div class="stack">
          <% if (honeypot) { %>
            <div class="subcard">
              <div class="card-head mb-3">
                <div><h3 class="subcard-title mb-0">État</h3><p class="card-desc"><span class="channel-tag"><%- icon('hash') %><%= honeypotChannelName || 'salon introuvable' %></span> · suppression des messages des <%= honeypot.deleteWindowMinutes %> dernières minutes</p></div>
                <label class="toggle" data-tooltip="<%= honeypot.enabled ? 'Activé' : 'Désactivé' %>"><input type="checkbox" data-toggle-url="<%= base %>/honeypot/toggle" data-toggle-label="Salon piège" <%= honeypot.enabled ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Actif</span></label>
              </div>
              <% if (!honeypotChannelName) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le salon configuré n'existe plus : recréez-le ci-dessous.</span></div><% } %>
              <form method="post" action="<%= base %>/honeypot/setup" class="form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="mode" value="<%= honeypotChannelName ? 'existing' : 'create' %>"><input type="hidden" name="channelId" value="<%= honeypotChannelName ? honeypot.channelId : '' %>">
                <div class="field"><label for="hp-window">Fenêtre de suppression (minutes)</label><input id="hp-window" name="windowMinutes" type="number" class="input" min="1" max="1440" value="<%= honeypot.deleteWindowMinutes %>" data-input-narrow></div>
                <div class="form-footer"><button type="submit" class="btn" <%= botReady ? '' : 'disabled' %>><%- icon('refresh', { size: 16 }) %><%= honeypotChannelName ? 'Mettre à jour et republier l’avertissement' : 'Recréer le salon' %></button></div>
              </form>
            </div>
            <form method="post" action="<%= base %>/honeypot/remove" class="subcard form" data-confirm="Retirer le salon piège ?" data-confirm-title="Retirer le salon piège" data-confirm-label="Retirer">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <h3 class="subcard-title"><%- icon('trash') %>Retirer le salon piège</h3>
              <label class="toggle toggle-sm"><input type="checkbox" name="deleteChannel"><span class="toggle-track"></span><span class="toggle-label">Supprimer aussi le salon Discord</span></label>
              <div class="form-footer"><button type="submit" class="btn btn-danger" <%= botReady ? '' : 'disabled' %>>Retirer le salon piège</button></div>
            </form>
          <% } else { %>
            <form method="post" action="<%= base %>/honeypot/setup" class="subcard form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <h3 class="subcard-title">Mettre en place un salon piège</h3>
              <div class="field"><span class="field-label">Salon</span>
                <div class="segmented"><label><input type="radio" name="mode" value="create" checked data-radio-toggle="#hp-create"><span>Créer un salon</span></label><label><input type="radio" name="mode" value="existing" data-radio-toggle="#hp-existing"><span>Utiliser un salon existant</span></label></div>
              </div>
              <div class="field" id="hp-create"><label for="hp-name">Nom du salon</label><input id="hp-name" name="name" class="input input-mono" maxlength="90" value="<%= honeypotDefaultName %>"><small class="hint">Créé en haut de la liste des salons, ouvert en écriture à tous.</small></div>
              <div class="field" id="hp-existing"><label for="hp-channel">Salon existant</label><%- include('../partials/channel-select', { name: 'channelId', id: 'hp-channel', selected: '', emptyLabel: '— Choisir —' }) %></div>
              <div class="field"><label for="hp-window2">Supprimer les messages des</label><div class="input-group"><input id="hp-window2" name="windowMinutes" type="number" class="input" min="1" max="1440" value="60" data-input-narrow><span class="input-addon">dernières minutes</span></div></div>
              <div class="form-footer"><button type="submit" class="btn btn-primary" <%= botReady ? '' : 'disabled' %>><%- icon('check', { size: 16 }) %>Activer le salon piège</button></div>
            </form>
          <% } %>
        </div>
        <aside class="split-preview">
          <div class="preview-panel">
            <div class="preview-panel-head"><span class="row"><%- icon('hash', { size: 14 }) %><%= honeypotChannelName || honeypotDefaultName %></span><span class="badge badge-muted">Message épinglé</span></div>
            <div class="preview-panel-body"><%- include('../partials/embed-preview', { embed: honeypotEmbed }) %></div>
            <div class="preview-panel-note">L'avertissement est volontairement en anglais pour être compris de tous les comptes.</div>
          </div>
        </aside>
      </div>
    </section>

    <section class="toc-section" id="danger-zone" aria-labelledby="danger-title">
      <div class="danger-zone">
        <div class="danger-zone-head">
          <h2 id="danger-title"><%- icon('alert-triangle') %>Actions sensibles</h2>
          <p>Effets immédiats et irréversibles sur tout le serveur. Chaque action demande une confirmation.</p>
        </div>
        <div class="danger-row" data-unban-all data-status-url="<%= base %>/unban-all/status" data-cancel-url="<%= base %>/unban-all/cancel"<%- jobRunning ? ' data-running' : '' %>>
          <div class="min-w-0">
            <div class="danger-row-title">Débannir tout le monde</div>
            <div class="danger-row-desc">Lève tous les bannissements du serveur, environ 2 par seconde. Une seule case récapitulative est ajoutée à l'historique des sanctions.</div>
            <div class="danger-row-meta"><span data-unban-count><%= jobRunning ? 'Débannissement en cours…' : 'Comptage des membres bannis…' %></span><% if (!massUnban.allowed) { %><span>· réservé au propriétaire et aux administrateurs du serveur</span><% } %></div>
          </div>
          <form method="post" action="<%= base %>/unban-all" class="stack-2" data-unban-form<%- jobRunning ? ' hidden' : '' %>>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="confirm" value="" data-confirm-target>
            <input name="reason" class="input input-sm" maxlength="300" placeholder="Raison (optionnelle)" aria-label="Raison du débannissement">
            <% if (massUnban.fivem) { %><label class="toggle toggle-sm"><input type="checkbox" name="syncGame" checked><span class="toggle-track"></span><span class="toggle-label">Aussi débannir en jeu (serveurs FiveM)</span></label><% } %>
            <button type="submit" class="btn btn-danger" data-unban-submit data-confirm="Tous les membres bannis de <%= guild.name %> vont être débannis. Les bannissements levés ne pourront pas être restaurés automatiquement." data-confirm-title="Débannir tout le monde" data-confirm-label="Débannir tout le monde" data-confirm-type="<%= massUnban.confirmWord %>" <%= botReady && massUnban.allowed ? '' : 'disabled' %>><%- icon('unlock', { size: 16 }) %>Débannir tout le monde</button>
          </form>
          <div class="unban-progress" data-unban-progress<%- job ? '' : ' hidden' %> role="status" aria-live="polite">
            <div class="progress-label"><span data-unban-text><%= job ? (jobRunning ? 'En cours' : job.cancelled ? 'Annulé' : 'Terminé') + ' : ' + job.done + ' débanni(s), ' + job.failed + ' échec(s) sur ' + job.total : '' %></span><span data-unban-pct></span></div>
            <span class="bar-track"><span class="bar-fill" data-unban-bar data-pct="<%= job && job.total ? Math.round(((job.done + job.failed) / job.total) * 100) : 0 %>"></span></span>
            <div class="row"><button type="button" class="btn btn-ghost btn-sm" data-unban-cancel<%- jobRunning ? '' : ' hidden' %>><%- icon('x', { size: 14 }) %>Arrêter le débannissement</button></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
<% } %>
