<section class="page-header">
  <div>
    <a class="link" href="/guilds/<%= guild.id %>/embeds">← Retour aux templates</a>
    <h2 class="page-title"><%= template ? 'Template « ' + template.name + ' »' : 'Nouveau template' %></h2>
    <p class="muted">L'aperçu se met à jour en direct. Les variables sont remplacées à l'envoi.</p>
  </div>
  <% if (template) { %>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/guilds/<%= guild.id %>/embeds/<%= template.id %>/export">Exporter JSON</a>
    <form method="post" action="/guilds/<%= guild.id %>/embeds/<%= template.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Supprimer le template « <%= template.name %> » ?">Supprimer</button></form>
  </div>
  <% } %>
</section>

<form method="post" action="/guilds/<%= guild.id %>/embeds<%= template ? '/' + template.id : '' %>" class="form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card">
    <div class="grid-2 grid-tight">
      <div class="field"><label for="tpl-name">Nom</label><input id="tpl-name" name="name" class="input" maxlength="100" required value="<%= template ? template.name : '' %>" placeholder="Maintenance"></div>
      <div class="field"><label for="tpl-description">Description interne</label><input id="tpl-description" name="description" class="input" maxlength="200" value="<%= template && template.description ? template.description : '' %>" placeholder="Utilisé pour…"></div>
    </div>
  </div>
  <div class="card">
    <h3 class="card-title">Contenu de l'embed</h3>
    <%- include('../partials/embed-editor', { prefix: 'embed', spec, id: 'tpl-embed', buttons, buttonsName: 'buttonsJson', withPreview: true, withJson: true }) %>
  </div>
  <div class="form-actions sticky-actions">
    <a class="btn btn-ghost" href="/guilds/<%= guild.id %>/embeds">Annuler</a>
    <button type="submit" class="btn btn-primary"><%= template ? 'Enregistrer' : 'Créer le template' %></button>
  </div>
</form>

<% if (template) { %>
<form method="post" action="/guilds/<%= guild.id %>/embeds/<%= template.id %>/send" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h3 class="card-title">Envoyer dans un salon</h3>
  <% if (!botReady) { %><div class="alert alert-warning"><span class="alert-icon" aria-hidden="true">⚠</span><span class="alert-text">Le bot n'est pas connecté : l'envoi est indisponible pour le moment.</span></div><% } %>
  <p class="muted">Envoie la version <strong>enregistrée</strong> du template (enregistrez vos modifications d'abord).</p>
  <div class="inline-fields">
    <div class="field"><label for="send-channel">Salon</label><select id="send-channel" name="channelId" class="select" required><%- include('../partials/channel-options', { channels: guild.textChannels, selected: '', allowEmpty: true, emptyLabel: '— Choisir un salon —' }) %></select></div>
    <div class="field"><label for="send-content">Texte au-dessus de l'embed (optionnel)</label><input id="send-content" name="content" class="input" maxlength="2000" placeholder="@everyone, {server}…"></div>
    <div class="field field-fixed"><button type="submit" class="btn btn-primary" <%= botReady ? '' : 'disabled' %>>Envoyer</button></div>
  </div>
</form>
<% } %>
