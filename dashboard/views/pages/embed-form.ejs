<% const b = `/guilds/${guild.id}/embeds`; const t = template; %>
<a class="back-link" href="<%= b %>"><%- icon('arrow-left', { size: 16 }) %>Embeds</a>
<header class="page-header">
  <div class="page-heading">
    <span class="page-icon"><%- icon('layout-template') %></span>
    <div>
      <h1 class="page-title"><%= t ? t.name : 'Nouveau template' %></h1>
      <p class="page-subtitle"><%= t ? (t.description ? t.description + ' · ' : '') + 'modifié ' + fmt.relative(t.updatedAt) : "Composez l'embed : l'aperçu se met à jour en direct." %></p>
    </div>
  </div>
  <% if (t) { %>
  <div class="page-actions">
    <a class="btn" href="<%= b %>/<%= t.id %>/export"><%- icon('download', { size: 16 }) %>Exporter JSON</a>
    <form method="post" action="<%= b %>/<%= t.id %>/delete" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Supprimer le template « <%= t.name %> » ?" data-confirm-label="Supprimer"><%- icon('trash', { size: 16 }) %>Supprimer</button></form>
  </div>
  <% } %>
</header>

<div class="split" data-no-live-reload>
  <form method="post" action="<%= b %><%= t ? '/' + t.id : '' %>" class="form stack" id="embed-form" <%- t ? 'data-dirty-form' : '' %>>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <section class="card">
      <div class="field-row">
        <div class="field"><label for="tpl-name" class="field-required">Nom</label><input id="tpl-name" name="name" class="input" maxlength="100" required value="<%= t ? t.name : '' %>" placeholder="Maintenance"></div>
        <div class="field"><label for="tpl-description">Description interne <span class="field-optional">optionnel</span></label><input id="tpl-description" name="description" class="input" maxlength="200" value="<%= t && t.description ? t.description : '' %>" placeholder="Utilisé pour…"></div>
      </div>
    </section>
    <section class="card">
      <h2 class="card-title">Embed &amp; boutons</h2>
      <%- include('../partials/embed-editor', { prefix: 'embed', spec, id: 'tpl-embed', buttons, buttonsName: 'buttonsJson', withPreview: false, previewTarget: '#embed-live-preview', contentSource: '#send-content', withJson: true }) %>
    </section>
    <% if (!t) { %>
      <div class="sticky-actions row justify-between"><span class="text-sm text-2">Vous pourrez l'envoyer dans un salon après création.</span><div class="btn-group"><a class="btn btn-ghost" href="<%= b %>">Annuler</a><button type="submit" class="btn btn-primary">Créer le template</button></div></div>
    <% } else { %>
      <div class="form-actions dirty-hide"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
    <% } %>
  </form>

  <aside class="split-preview">
    <div class="preview-panel">
      <div class="preview-panel-head"><span class="row"><%- icon('eye', { size: 15 }) %>Aperçu en direct</span><span class="badge badge-muted">Discord</span></div>
      <div class="preview-panel-body" id="embed-live-preview"><%- include('../partials/embed-preview', { embed: spec, buttons, content: '' }) %></div>
    </div>

    <% if (t) { %>
    <form method="post" action="<%= b %>/<%= t.id %>/send" class="card form" id="send">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2 class="card-title"><%- icon('send') %>Envoyer dans un salon</h2>
      <% if (!botReady) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Bot hors ligne : envoi indisponible.</span></div><% } %>
      <div class="field"><label for="send-channel" class="field-required">Salon</label><%- include('../partials/channel-select', { name: 'channelId', id: 'send-channel', selected: '', emptyLabel: '— Choisir un salon —', required: true }) %></div>
      <div class="field"><label for="send-content">Texte au-dessus <span class="field-optional">optionnel</span></label><input id="send-content" name="content" class="input" maxlength="2000" placeholder="@everyone, {server}…"></div>
      <p class="hint mb-3">La version <strong>enregistrée</strong> est envoyée : enregistrez vos modifications d'abord.</p>
      <button type="submit" class="btn btn-primary btn-block" <%= botReady ? '' : 'disabled' %>><%- icon('send', { size: 16 }) %>Envoyer</button>
    </form>
    <% } %>

    <details class="card card-collapsible">
      <summary><span class="row"><%- icon('sparkles', { size: 16 }) %><strong>Variables disponibles</strong></span></summary>
      <div class="var-list mt-4"><% for (const [k, v] of Object.entries(constants.TEMPLATE_VARIABLES)) { %><div><code><%= k %></code><span class="text-3"><%= v %></span></div><% } %></div>
    </details>
  </aside>
</div>
