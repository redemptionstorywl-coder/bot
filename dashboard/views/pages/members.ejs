<% const base = `/guilds/${guild.id}`; %>
<header class="page-header">
  <div class="page-heading">
    <div><%- include('../partials/eyebrow') %><h1 class="page-title">Membres</h1><p class="page-subtitle"><%= fmt.number(total) %> membres sur le serveur. Recherchez par pseudo, nom d'utilisateur ou ID.</p></div>
  </div>
</header>

<form method="get" action="<%= base %>/members" class="row mb-5" role="search">
  <label class="search grow"><%- icon('search', { size: 16 }) %><input type="search" name="q" class="input input-lg" value="<%= q %>" placeholder="Rechercher un membre…" aria-label="Rechercher un membre" maxlength="100" autofocus></label>
  <button type="submit" class="btn btn-primary btn-lg">Rechercher</button>
  <% if (q) { %><a class="btn btn-ghost btn-lg" href="<%= base %>/members">Effacer</a><% } %>
</form>

<section class="card card-flush">
  <div class="card-head"><h2 class="card-title"><%= q ? 'Résultats pour « ' + q + ' »' : 'Arrivées récentes' %></h2><span class="text-xs text-3"><%= members.length %> affiché(s)</span></div>
  <% if (!members.length) { %>
    <%- include('../partials/empty', { glyph: q ? 'search' : 'users', title: q ? 'Aucun membre trouvé' : 'Aucun membre en cache', text: q ? 'Vérifiez l’orthographe ou essayez avec l’ID Discord.' : 'Recherchez un membre pour afficher sa fiche.' }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table table-responsive table-clickable" id="members-table">
      <thead><tr><th>Membre</th><th>Rôles</th><th>Arrivée</th><th class="shrink"></th></tr></thead>
      <tbody>
        <% for (const m of members) { %>
          <tr data-href="<%= base %>/members/<%= m.id %>">
            <td class="cell-primary"><div class="user-cell"><img class="avatar avatar-md" src="<%= m.avatarUrl %>" alt=""><div class="user-cell-text"><span class="user-cell-name"><%= m.displayName %><% if (m.bot) { %> <span class="badge badge-info">APP</span><% } %></span><span class="user-cell-sub">@<%= m.username %></span></div></div></td>
            <td data-label="Rôles"><div class="badges"><% for (const r of m.roles) { %><span class="role-pill" data-role-color="<%= r.color %>"><span class="role-dot"></span><span><%= r.name %></span></span><% } %><% if (m.roleCount > m.roles.length) { %><span class="badge badge-muted">+<%= m.roleCount - m.roles.length %></span><% } %><% if (!m.roleCount) { %><span class="text-3 text-xs">aucun</span><% } %></div></td>
            <td data-label="Arrivée" class="nowrap"><span title="<%= fmt.dateTime(m.joinedAt) %>"><%= m.joinedAt ? fmt.relative(m.joinedAt) : '—' %></span></td>
            <td class="shrink"><a class="btn btn-ghost btn-sm" href="<%= base %>/members/<%= m.id %>">Fiche<%- icon('chevron-right', { size: 14 }) %></a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
