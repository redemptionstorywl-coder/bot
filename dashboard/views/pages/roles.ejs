<%
  const base = `/guilds/${guild.id}/roles`;
  const roleOf = (id) => guild.roles.find((r) => r.id === id);
  const pill = (id) => { const r = roleOf(id); return `<span class="role-pill" data-role-color="${r ? r.color : '#71717a'}"><span class="role-dot"></span><span>${(r ? r.name : 'Rôle supprimé').replace(/[&<>"']/g, '')}</span></span>`; };
  const menuComponents = (m) => m.style === 'SELECT'
    ? [{ type: 'select', placeholder: m.placeholder || placeholderDefault, options: m.optionList.map((o) => ({ label: o.label || ((roleOf(o.roleId) || {}).name || 'rôle'), emoji: o.emoji, description: o.description })) }]
    : [];
  const menuButtons = (m) => m.style === 'SELECT' ? [] : m.optionList.map((o) => ({ label: o.label || ((roleOf(o.roleId) || {}).name || 'rôle'), emoji: o.emoji, style: o.style || 'secondary' }));
%>
<%- include('../partials/roles-header', { rtab: tab }) %>

<% if (tab === 'autoroles') { %>
  <% if (!modules.autorole) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Auto-rôles est désactivé : aucun rôle ne sera attribué automatiquement. <a class="link" href="/guilds/<%= guild.id %>/settings?tab=modules">Activer</a></span></div><% } %>
  <div class="grid-aside-right grid-2">
    <section class="card card-flush">
      <div class="card-head"><div><h2 class="card-title">Règles actives</h2><p class="card-desc">Rôles attribués automatiquement aux nouveaux membres.</p></div></div>
      <% if (!autoroles.length) { %>
        <%- include('../partials/empty', { glyph: 'user-plus', title: 'Aucun auto-rôle', text: 'Ajoutez un rôle à donner automatiquement à l’arrivée, après vérification ou aux bots.', compact: true }) %>
      <% } else { %>
      <ul class="list">
        <% for (const a of autoroles) { const tp = autoroleTypes.find((t) => t.value === a.type); %>
          <li class="list-item<%= a.enabled ? '' : ' row-disabled' %>">
            <span class="list-item-icon"><%- icon(a.type === 'BOT' ? 'bot' : a.type === 'VERIFIED' ? 'user-check' : 'user-plus') %></span>
            <div class="list-item-body"><div class="list-item-title"><%- pill(a.roleId) %></div><div class="list-item-meta"><%= tp ? tp.label : a.type %> · <%= a.delaySeconds ? 'après ' + fmt.duration(a.delaySeconds) : 'immédiat' %></div></div>
            <form method="post" action="<%= base %>/autoroles/delete" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="roleId" value="<%= a.roleId %>"><input type="hidden" name="type" value="<%= a.type %>"><button type="submit" class="icon-btn is-danger" data-confirm="Retirer cet auto-rôle ?" data-confirm-label="Retirer" aria-label="Retirer" data-tooltip="Retirer"><%- icon('trash', { size: 16 }) %></button></form>
          </li>
        <% } %>
      </ul>
      <% } %>
    </section>
    <form method="post" action="<%= base %>/autoroles" class="card form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2 class="card-title"><%- icon('plus') %>Ajouter un auto-rôle</h2>
      <div class="field"><label for="ar-role" class="field-required">Rôle</label><%- include('../partials/role-select', { name: 'roleId', id: 'ar-role', selected: '', multiple: false, required: true, emptyLabel: '— Choisir —' }) %></div>
      <div class="field"><span class="field-label">Déclencheur</span>
        <div class="stack-2"><% autoroleTypes.filter((x) => x.active).forEach((t, i) => { %><label class="choice"><input type="radio" name="type" value="<%= t.value %>" <%= i === 0 ? 'checked' : '' %>><span class="choice-title"><%= t.label %></span></label><% }) %></div>
      </div>
      <div class="field"><label for="ar-delay">Délai</label><div class="input-group"><input id="ar-delay" name="delayMinutes" type="number" class="input" min="0" max="1440" value="0" data-input-narrow><span class="input-addon">minutes</span></div><small class="hint">0 = immédiat, 1440 max.</small></div>
      <button type="submit" class="btn btn-primary btn-block">Ajouter</button>
    </form>
  </div>

<% } else if (tab === 'menus') { %>
  <% if (!modules.rolemenu) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Menus de rôles est désactivé : les menus publiés ne répondent pas. <a class="link" href="/guilds/<%= guild.id %>/settings?tab=modules">Activer</a></span></div><% } %>
  <% if (!menus.length) { %>
    <div class="card"><%- include('../partials/empty', { glyph: 'tags', title: 'Aucun menu de rôles', text: 'Un message avec des boutons ou un menu déroulant pour que les membres choisissent leurs rôles.', actionHref: base + '/menus/new', actionLabel: 'Créer un menu' }) %></div>
  <% } else { %>
  <div class="panel-list">
    <% for (const m of menus) { %>
      <article class="card panel-card mb-0">
        <div class="row justify-between">
          <div class="strong truncate"><%= m.name %></div>
          <div class="row"><% if (m.exclusive) { %><span class="badge">exclusif</span><% } %><span class="badge <%= m.style === 'SELECT' ? 'badge-info' : 'badge-accent' %>"><%= m.style === 'SELECT' ? 'Menu' : 'Boutons' %></span></div>
        </div>
        <div class="preview-panel"><div class="preview-panel-body"><%- include('../partials/embed-preview', { embed: Object.keys(m.embed || {}).length ? m.embed : { title: m.name }, buttons: menuButtons(m), components: menuComponents(m), compact: true }) %></div></div>
        <div class="panel-meta"><span><%= m.optionList.length %> rôle(s)</span><% if (m.messageId) { %><span>· #<%= channelName(m.channelId) %></span><a class="link" href="https://discord.com/channels/<%= guild.id %>/<%= m.channelId %>/<%= m.messageId %>" target="_blank" rel="noopener noreferrer">Voir sur Discord<%- icon('external-link', { size: 12 }) %></a><% } else { %><span class="badge badge-warning">non publié</span><% } %></div>
        <div class="row">
          <a class="btn btn-sm" href="<%= base %>/menus/<%= m.id %>"><%- icon('pencil', { size: 14 }) %>Modifier</a>
          <form method="post" action="<%= base %>/menus/<%= m.id %>/delete" class="inline-form ml-auto"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger btn-sm" data-confirm="Supprimer le menu « <%= m.name %> » et son message Discord ?" data-confirm-label="Supprimer"><%- icon('trash', { size: 14 }) %>Supprimer</button></form>
        </div>
      </article>
    <% } %>
  </div>
  <% } %>

<% } else { %>
  <% if (!modules.notifications) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Notifications est désactivé : le panneau publié ne répond pas. <a class="link" href="/guilds/<%= guild.id %>/settings?tab=modules">Activer</a></span></div><% } %>
  <div class="grid-aside-right grid-2">
    <div class="stack">
      <section class="card card-flush">
        <div class="card-head">
          <div><h2 class="card-title">Rôles de notification</h2><p class="card-desc">Les membres s'abonnent aux annonces qui les intéressent.</p></div>
          <form method="post" action="<%= base %>/notifications/setup" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm" data-confirm="Créer les rôles de notification manquants (<%= defaultNotifications.map((d) => d.label).join(', ') %>) ?" data-confirm-variant="primary" data-confirm-label="Créer" <%= botReady ? '' : 'disabled' %>><%- icon('sparkles', { size: 14 }) %>Configuration par défaut</button></form>
        </div>
        <% if (!notifications.length) { %>
          <%- include('../partials/empty', { glyph: 'bell', title: 'Aucune notification', text: 'Utilisez la configuration par défaut ou ajoutez-en une.', compact: true }) %>
        <% } else { %>
        <ul class="list">
          <% for (const n of notifications) { %>
            <li class="list-item<%= n.enabled ? '' : ' row-disabled' %>">
              <span class="reason-emoji" aria-hidden="true"><%= n.emoji || '🔔' %></span>
              <div class="list-item-body"><div class="list-item-title"><%= n.label %> <code class="text-xs"><%= n.key %></code></div><div class="list-item-meta"><%- pill(n.roleId) %> <%= n.description || '' %></div></div>
              <% if (!n.enabled) { %><span class="badge badge-muted">masquée</span><% } %>
              <button type="button" class="btn btn-ghost btn-sm" data-fill-form="#notif-form" data-form-title-text="Modifier « <%= n.label %> »" data-set-key="<%= n.key %>" data-set-roleId="<%= n.roleId %>" data-set-label="<%= n.label %>" data-set-emoji="<%= n.emoji || '' %>" data-set-description="<%= n.description || '' %>" data-set-order="<%= n.order %>" data-set-enabled="<%= n.enabled ? '1' : '' %>"><%- icon('pencil', { size: 14 }) %>Modifier</button>
              <form method="post" action="<%= base %>/notifications/<%= n.key %>/delete" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="icon-btn is-danger" data-confirm="Retirer la notification « <%= n.label %> » ? Le rôle Discord est conservé." data-confirm-label="Retirer" aria-label="Retirer"><%- icon('trash', { size: 16 }) %></button></form>
            </li>
          <% } %>
        </ul>
        <% } %>
      </section>
      <form method="post" action="<%= base %>/notifications/publish" class="card form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2 class="card-title"><%- icon('send') %>Publier le panneau d'abonnement</h2>
        <div class="field-row">
          <div class="field"><label for="np-channel" class="field-required">Salon</label><%- include('../partials/channel-select', { name: 'channelId', id: 'np-channel', selected: '', emptyLabel: '— Choisir un salon —', required: true }) %></div>
          <div class="field"><span class="field-label">Style</span><div class="segmented"><label><input type="radio" name="style" value="SELECT" checked><span>Menu (multi)</span></label><label><input type="radio" name="style" value="BUTTONS"><span>Boutons</span></label></div></div>
        </div>
        <div class="form-footer"><button type="submit" class="btn btn-primary" <%= botReady && notifications.length ? '' : 'disabled' %>>Publier</button></div>
      </form>
    </div>
    <form method="post" action="<%= base %>/notifications" class="card form" id="notif-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2 class="card-title" data-form-title>Ajouter une notification</h2>
      <div class="field"><label for="nf-label" class="field-required">Libellé</label><input id="nf-label" name="label" class="input" maxlength="100" required placeholder="Événements"></div>
      <div class="field-row">
        <div class="field"><label for="nf-key" class="field-required">Clé</label><input id="nf-key" name="key" class="input input-mono" maxlength="64" required pattern="^[a-z0-9_-]{1,64}$" placeholder="events"></div>
        <div class="field"><label for="nf-emoji">Emoji</label><input id="nf-emoji" name="emoji" class="input" maxlength="64" placeholder="🎉"></div>
      </div>
      <div class="field mt-4"><label for="nf-role" class="field-required">Rôle</label><%- include('../partials/role-select', { name: 'roleId', id: 'nf-role', selected: '', multiple: false, required: true, emptyLabel: '— Choisir —' }) %></div>
      <div class="field"><label for="nf-description">Description</label><input id="nf-description" name="description" class="input" maxlength="100" placeholder="Soirées et événements du serveur"></div>
      <div class="field-row">
        <div class="field"><label for="nf-order">Ordre</label><input id="nf-order" name="order" type="number" class="input" min="0" max="1000" value="0"></div>
        <div class="field"><span class="field-label">Visibilité</span><label class="toggle mt-2"><input type="checkbox" name="enabled" id="nf-enabled" checked><span class="toggle-track"></span><span class="toggle-label">Sur le panneau</span></label></div>
      </div>
      <div class="form-footer"><button type="reset" class="btn btn-ghost">Vider</button><button type="submit" class="btn btn-primary">Enregistrer</button></div>
    </form>
  </div>
<% } %>
