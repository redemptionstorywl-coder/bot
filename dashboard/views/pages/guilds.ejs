<section class="page-header">
  <div>
    <h2 class="page-title">Vos serveurs</h2>
    <p class="muted">Serveurs où vous êtes propriétaire ou administrateur. Le bot doit être présent pour gérer un serveur.</p>
  </div>
  <div class="page-actions"><input type="search" class="input" placeholder="Filtrer…" data-filter="#guild-cards" aria-label="Filtrer les serveurs"></div>
</section>

<% if (!botReady) { %>
  <div class="alert alert-warning"><span class="alert-icon" aria-hidden="true">⚠</span><span class="alert-text">Le bot termine son démarrage : la présence sur les serveurs sera connue dans quelques secondes.</span></div>
<% } %>

<% if (!cards.length) { %>
  <div class="card empty-state">
    <p>Aucun serveur administrable trouvé sur votre compte Discord.</p>
    <p class="muted">Vous devez être propriétaire ou disposer de la permission « Gérer le serveur » / « Administrateur ».</p>
  </div>
<% } else { %>
<div class="card-grid" id="guild-cards">
  <% for (const g of cards) { %>
    <article class="card guild-card" data-filter-item data-filter-text="<%= g.name.toLowerCase() %>">
      <div class="guild-card-head">
        <% if (g.iconUrl) { %><img class="avatar avatar-lg" src="<%= g.iconUrl %>" alt=""><% } else { %><span class="avatar avatar-lg avatar-fallback"><%= fmt.initials(g.name) %></span><% } %>
        <div class="guild-card-meta">
          <h3 class="truncate" title="<%= g.name %>"><%= g.name %></h3>
          <div class="badges">
            <% if (g.owner) { %><span class="badge">Propriétaire</span><% } %>
            <% if (g.botPresent) { %><span class="badge badge-primary">Bot présent</span><% } else { %><span class="badge badge-muted">Bot absent</span><% } %>
            <% if (g.memberCount !== null) { %><span class="badge badge-muted"><%= fmt.number(g.memberCount) %> membres</span><% } %>
          </div>
        </div>
      </div>
      <div class="guild-card-actions">
        <% if (g.botPresent) { %>
          <a class="btn btn-primary btn-block" href="/guilds/<%= g.id %>">Gérer</a>
        <% } else { %>
          <a class="btn btn-ghost btn-block" href="<%= g.inviteUrl %>" target="_blank" rel="noopener">Inviter le bot</a>
        <% } %>
      </div>
    </article>
  <% } %>
</div>
<% } %>
