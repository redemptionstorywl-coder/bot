<% const present = cards.filter((g) => g.botPresent); const absent = cards.filter((g) => !g.botPresent); %>
<header class="page-header">
  <div>
    <p class="eyebrow">Vos serveurs</p>
    <h1 class="page-title">Choisir un serveur</h1>
    <p class="page-subtitle">Serveurs dont vous êtes propriétaire ou administrateur. Le bot doit y être présent pour les gérer ici.</p>
  </div>
  <div class="page-actions">
    <% if (cards.length > 6) { %><label class="search"><%- icon('search', { size: 16 }) %><input type="search" class="input" placeholder="Rechercher un serveur…" data-filter="#guild-cards" data-filter-empty="#guild-empty" aria-label="Rechercher un serveur"></label><% } %>
    <a class="btn" href="<%= inviteUrl %>" target="_blank" rel="noopener"><%- icon('plus', { size: 16 }) %>Ajouter le bot</a>
  </div>
</header>

<% if (!botReady) { %>
  <div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le bot termine son démarrage : sa présence sur vos serveurs sera connue dans quelques secondes.</span></div>
<% } %>

<% if (!cards.length) { %>
  <%- include('../partials/empty', { glyph: 'server', title: 'Aucun serveur administrable', text: 'Vous devez être propriétaire ou avoir la permission « Gérer le serveur » sur un serveur Discord.', actionHref: inviteUrl, actionLabel: 'Inviter le bot', actionIcon: 'plus' }) %>
<% } else { %>
<ul class="guild-list" id="guild-cards">
  <% if (present.length && absent.length) { %><li class="guild-row-group" data-filter-skip>Bot présent · <%= present.length %></li><% } %>
  <% present.concat(absent).forEach((g, i) => { %>
    <% if (absent.length && i === present.length) { %><li class="guild-row-group" data-filter-skip>Bot absent · <%= absent.length %></li><% } %>
    <li class="guild-row<%= g.botPresent ? '' : ' is-inactive' %>" data-filter-item data-filter-text="<%= g.name.toLowerCase() %>">
      <% if (g.iconUrl) { %><img class="avatar avatar-md" src="<%= g.iconUrl %>" alt=""><% } else { %><span class="avatar avatar-md avatar-fallback avatar-square"><%= fmt.initials(g.name) %></span><% } %>
      <div class="guild-row-main">
        <div class="guild-row-name" title="<%= g.name %>"><%= g.name %></div>
        <div class="guild-row-sub">
          <% if (g.memberCount !== null) { %><span><%= fmt.number(g.memberCount) %> membres</span><% } %>
          <% if (g.owner) { %><span class="row"><%- icon('crown', { size: 12 }) %>Propriétaire</span><% } else { %><span>Administrateur</span><% } %>
        </div>
      </div>
      <span class="guild-row-state"><span class="dot <%= g.botPresent ? 'dot-success' : 'dot-muted' %>" aria-hidden="true"></span><%= g.botPresent ? 'Bot présent' : 'Bot absent' %></span>
      <% if (g.botPresent) { %>
        <a class="btn btn-primary btn-sm" href="/guilds/<%= g.id %>">Gérer<%- icon('arrow-right', { size: 14 }) %></a>
      <% } else { %>
        <a class="btn btn-sm" href="<%= g.inviteUrl %>" target="_blank" rel="noopener"><%- icon('plus', { size: 14 }) %>Inviter le bot</a>
      <% } %>
    </li>
  <% }) %>
</ul>
<div id="guild-empty" hidden><%- include('../partials/empty', { glyph: 'search', title: 'Aucun serveur ne correspond', compact: true }) %></div>
<% } %>
