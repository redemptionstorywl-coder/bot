<% const b = `/guilds/${guild.id}/tickets`; const maxType = Math.max(1, ...byType.map((x) => x.count)); %>
<%- include('../partials/tickets-header', { tab: 'stats' }) %>

<section class="stat-grid" data-live-reload>
  <div class="stat"><span class="stat-label"><%- icon('inbox', { size: 14 }) %>Ouverts</span><strong class="stat-value"><%= fmt.number(stats.open) %></strong><span class="stat-sub">en attente de fermeture</span></div>
  <div class="stat"><span class="stat-label"><%- icon('archive', { size: 14 }) %>Fermés</span><strong class="stat-value"><%= fmt.number(stats.closed) %></strong><span class="stat-sub"><%= fmt.number(stats.deleted) %> supprimés · <%= fmt.number(stats.total) %> au total</span></div>
  <div class="stat"><span class="stat-label"><%- icon('clock', { size: 14 }) %>1re réponse du staff</span><strong class="stat-value stat-value-sm"><%= response.avgSeconds !== null ? fmt.duration(response.avgSeconds) : '—' %></strong><span class="stat-sub"><%= response.avgSeconds !== null ? 'moyenne sur ' + response.sample + ' tickets · médiane ' + fmt.duration(response.medianSeconds) : 'calculée sur les tickets fermés' %></span></div>
  <div class="stat"><span class="stat-label"><%- icon('hourglass', { size: 14 }) %>Durée moyenne</span><strong class="stat-value stat-value-sm"><%= stats.avgDurationSeconds ? fmt.duration(stats.avgDurationSeconds) : '—' %></strong><span class="stat-sub"><%= stats.avgMessages ? stats.avgMessages + ' messages en moyenne' : 'de l’ouverture à la fermeture' %></span></div>
</section>

<section class="card" aria-label="Activité sur 14 jours">
  <%- include('../partials/chart-line', { chart: activityChart, title: 'Activité sur 14 jours', sub: 'Tickets ouverts et fermés par jour.', emptyText: 'Aucun ticket ouvert ni fermé sur les 14 derniers jours.' }) %>
</section>

<div class="grid-2">
  <section class="card">
    <h2 class="card-title"><%- icon('list') %>Par raison</h2>
    <% if (!byType.length) { %>
      <%- include('../partials/empty', { glyph: 'bar-chart', title: 'Pas encore de données', compact: true }) %>
    <% } else { %>
    <ul class="bars">
      <% for (const x of byType) { %>
        <li class="bar-row"><span class="bar-label"><span aria-hidden="true"><%= x.emoji || '🎫' %></span><span class="truncate"><%= x.label %></span></span><span class="bar-track"><span class="bar-fill" data-pct="<%= fmt.percent(x.count, maxType) %>"></span></span><span class="bar-value"><%= fmt.number(x.count) %> · <%= fmt.percent(x.count, stats.total) %> %</span></li>
      <% } %>
    </ul>
    <% } %>
  </section>
  <section class="card">
    <h2 class="card-title"><%- icon('user-check') %>Staff le plus actif</h2>
    <p class="card-desc">Tickets fermés par membre du staff (hors fermeture par le créateur).</p>
    <% if (!closers.length) { %>
      <%- include('../partials/empty', { glyph: 'users', title: 'Aucun ticket fermé par le staff', compact: true }) %>
    <% } else { %>
    <ul class="list">
      <% closers.forEach((c, i) => { %>
        <li class="list-item">
          <span class="text-3 tabular strong">#<%= i + 1 %></span>
          <% if (c.profile) { %><img class="avatar avatar-sm" src="<%= c.profile.avatarUrl %>" alt=""><% } else { %><span class="avatar avatar-sm avatar-fallback">?</span><% } %>
          <div class="list-item-body"><a class="list-item-title link-quiet" href="/guilds/<%= guild.id %>/members/<%= c.userId %>"><%= c.profile ? c.profile.name : c.userId %></a></div>
          <span class="badge"><%= fmt.number(c.count) %> ticket<%= c.count > 1 ? 's' : '' %></span>
        </li>
      <% }) %>
    </ul>
    <% } %>
  </section>
</div>
