<%
  const b = `/guilds/${guild.id}/whitelist`;
  const sq = (status, extra) => { const p = new URLSearchParams(); p.set('status', status); if (filters.q) p.set('q', filters.q); if (extra) for (const [k, v] of Object.entries(extra)) p.set(k, v); return `${b}?${p}`; };
  const statusIcon = { PENDING: 'hourglass', ACCEPTED: 'check-circle', REJECTED: 'x-circle' };
%>
<header class="page-header">
  <div class="page-heading">
    <span class="page-icon"><%- icon('clipboard-check') %></span>
    <div><h1 class="page-title row-wrap"><span>Whitelist</span><span class="badge <%= settings.enabled ? 'badge-success' : 'badge-muted' %>"><span class="dot <%= settings.enabled ? 'dot-success' : '' %>"></span><%= settings.enabled ? 'Candidatures ouvertes' : 'Candidatures fermées' %></span></h1><p class="page-subtitle">Candidatures via <code>/whitelist</code>, décisions du staff, identifiants FiveM et formulaire.</p></div>
  </div>
</header>

<% if (!moduleEnabled) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Whitelist est désactivé : la commande <code>/whitelist</code> ne répond pas. <a class="link" href="/guilds/<%= guild.id %>/settings?tab=modules">Activer le module</a></span></div><% } %>

<%- include('../partials/tabs', { active: tab, label: 'Sections de la whitelist', tabs: [
  { key: 'applications', label: 'Dossiers', href: b, icon: 'inbox', count: counts.PENDING ? counts.PENDING + ' en attente' : null },
  { key: 'config', label: 'Formulaire & réglages', href: b + '?tab=config', icon: 'settings' },
] }) %>

<% if (tab === 'applications') { %>
  <div class="toolbar mb-4">
    <nav class="segmented" aria-label="Filtrer par statut">
      <% for (const s of Object.keys(statusLabels)) { %><a href="<%= sq(s) %>"<%- filters.status === s ? ' aria-current="page"' : '' %>><%- icon(statusIcon[s], { size: 15 }) %><%= s === 'PENDING' ? 'En attente' : s === 'ACCEPTED' ? 'Acceptées' : 'Refusées' %><span class="seg-count"><%= counts[s] %></span></a><% } %>
      <a href="<%= sq('all') %>"<%- filters.status === 'all' ? ' aria-current="page"' : '' %>>Tous<span class="seg-count"><%= total %></span></a>
    </nav>
    <form method="get" action="<%= b %>" class="row-wrap" role="search">
      <input type="hidden" name="status" value="<%= filters.status %>">
      <label class="search"><%- icon('search', { size: 16 }) %><input type="search" name="q" class="input input-sm" value="<%= filters.q %>" placeholder="N°, membre, identifiant, réponse…" aria-label="Rechercher un dossier"></label>
      <button type="submit" class="btn btn-sm">Rechercher</button>
      <% if (filters.q) { %><a class="btn btn-ghost btn-sm" href="<%= sq(filters.status) %>">Effacer</a><% } %>
    </form>
  </div>

  <div class="<%= selected ? 'grid-2 grid-aside-wide' : '' %>">
    <section class="card card-flush" data-live-reload>
      <% if (!applications.length) { %>
        <%- include('../partials/empty', { glyph: 'clipboard-check', title: filters.q ? 'Aucun résultat' : filters.status === 'PENDING' ? 'Aucun dossier en attente' : 'Aucun dossier', text: filters.q ? 'Aucun dossier ne correspond à cette recherche.' : filters.status === 'PENDING' ? 'Tout est traité. Les nouvelles candidatures arriveront ici.' : 'Les candidatures déposées avec /whitelist apparaîtront ici.' }) %>
      <% } else { %>
      <div class="table-wrap">
        <table class="table table-responsive table-clickable">
          <thead><tr><th class="shrink">#</th><th>Candidat</th><th>Statut</th><th>Déposé</th><% if (!selected) { %><th>Identifiant</th><th>Traité par</th><% } %></tr></thead>
          <tbody>
            <% for (const r of applications) { const href = sq(filters.status, { id: r.id }); %>
              <tr data-href="<%= href %>"<%- selected && selected.id === r.id ? ' class="is-selected"' : '' %>>
                <td class="cell-primary"><a class="link strong" href="<%= href %>">#<%= r.id %></a></td>
                <td data-label="Candidat"><span class="truncate"><%= names[r.userId] || r.userId %></span></td>
                <td data-label="Statut"><span class="badge badge-status-<%= r.status %>"><%= statusLabels[r.status] %></span></td>
                <td data-label="Déposé" class="nowrap text-2" title="<%= fmt.dateTime(r.createdAt) %>"><%= fmt.relative(r.createdAt) %></td>
                <% if (!selected) { %>
                <td data-label="Identifiant" class="mono text-xs"><%= r.identifier ? fmt.truncate(r.identifier, 30) : '—' %></td>
                <td data-label="Traité par" class="text-2"><%= r.reviewedById ? (names[r.reviewedById] || r.reviewedById) : '—' %></td>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (applications.length >= 200) { %><p class="hint card-body">Seuls les 200 dossiers les plus récents sont affichés : affinez par statut ou recherche.</p><% } %>
      <% } %>
    </section>

    <% if (selected) { %>
    <aside class="card sheet" aria-label="Dossier #<%= selected.id %>">
      <div class="card-head">
        <div><h2 class="card-title">Dossier #<%= selected.id %></h2><p class="card-desc">Déposé <%= fmt.relative(selected.createdAt) %></p></div>
        <span class="row"><span class="badge badge-status-<%= selected.status %>"><%= statusLabels[selected.status] %></span><a class="icon-btn" href="<%= sq(filters.status) %>" aria-label="Fermer le dossier"><%- icon('x', { size: 16 }) %></a></span>
      </div>
      <dl class="dl">
        <dt>Candidat</dt><dd><a class="link" href="/guilds/<%= guild.id %>/members/<%= selected.userId %>"><%= names[selected.userId] || selected.userId %></a> <span class="mono text-xs text-3"><%= selected.userId %></span></dd>
        <dt>Identifiant</dt><dd class="mono text-xs"><%= selected.identifier || '—' %></dd>
        <% if (selected.reviewedById) { %><dt>Traité par</dt><dd><%= names[selected.reviewedById] || selected.reviewedById %> · <%= fmt.relative(selected.reviewedAt) %></dd><% } %>
        <% if (selected.note) { %><dt>Note</dt><dd class="pre-wrap"><%= selected.note %></dd><% } %>
      </dl>

      <h3 class="section-title mt-5">Réponses</h3>
      <% if (!selected.answers.length) { %><p class="text-sm text-3">Aucune réponse enregistrée.</p><% } else { %>
        <div class="qa-list"><% for (const a of selected.answers) { %><div class="qa-item"><div class="qa-q"><%= a.question %></div><div class="qa-a"><%= a.answer || '—' %></div></div><% } %></div>
      <% } %>

      <% if (selected.status === 'PENDING') { %>
        <h3 class="section-title mt-5">Décision</h3>
        <% if (!botReady) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Bot hors ligne : rôles et DM seront appliqués plus tard.</span></div><% } %>
        <form method="post" action="<%= b %>/applications/<%= selected.id %>/review" class="form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label for="wl-note">Note au candidat <span class="field-optional">optionnel</span></label><textarea id="wl-note" name="note" class="textarea" maxlength="1000" rows="3" placeholder="Bienvenue ! / Merci de détailler votre personnage…"></textarea></div>
          <div class="btn-row">
            <button type="submit" name="decision" value="REJECTED" class="btn btn-danger" data-confirm="Refuser le dossier #<%= selected.id %> ?" data-confirm-label="Refuser"><%- icon('x-circle', { size: 16 }) %>Refuser</button>
            <button type="submit" name="decision" value="ACCEPTED" class="btn btn-success" data-confirm="Accepter le dossier #<%= selected.id %> et attribuer le rôle whitelist ?" data-confirm-label="Accepter" data-confirm-variant="primary"><%- icon('check-circle', { size: 16 }) %>Accepter</button>
          </div>
        </form>
      <% } %>

      <details class="editor-section mt-5">
        <summary>Lier un identifiant FiveM</summary>
        <form method="post" action="<%= b %>/applications/<%= selected.id %>/identifier" class="row-wrap">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="identifier" class="input input-sm input-mono grow" required maxlength="128" placeholder="license:abcd1234…" value="<%= selected.identifier || '' %>" aria-label="Identifiant FiveM">
          <button type="submit" class="btn btn-sm"><%- icon('link', { size: 14 }) %>Lier</button>
        </form>
      </details>
      <details class="editor-section">
        <summary>Message de review sur Discord</summary>
        <div class="preview-panel"><div class="preview-panel-body"><%- reviewPreview %></div></div>
      </details>
    </aside>
    <% } %>
  </div>
<% } else { %>
  <form method="post" action="<%= b %>/config" class="split" id="wl-config-form" data-dirty-form data-no-live-reload>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="stack">
      <section class="card">
        <div class="card-head"><div><h2 class="card-title">Questions du formulaire</h2><p class="card-desc">Jusqu'à <%= maxQuestions %> questions dans une fenêtre Discord. Sans question, les questions par défaut (traduites) sont posées.</p></div></div>
        <div class="repeater" data-repeater data-repeater-max="<%= maxQuestions %>" data-repeater-json="#wl-questions-json" data-repeater-require="label" id="wl-questions">
          <div class="q-list" data-repeater-rows>
            <% settings.questions.forEach((q, i) => { %><%- include('../partials/question-row', { q, index: i, withMaxLength: false, defaultStyle: 'paragraph' }) %><% }) %>
          </div>
          <template data-repeater-template><%- include('../partials/question-row', { q: null, index: 0, withMaxLength: false, defaultStyle: 'paragraph' }) %></template>
          <div class="repeater-foot"><button type="button" class="btn btn-sm" data-repeater-add><%- icon('plus', { size: 14 }) %>Ajouter une question</button><span class="hint" data-repeater-count></span></div>
          <input type="hidden" name="questionsJson" id="wl-questions-json" value="<%= JSON.stringify(settings.questions) %>">
        </div>
        <% if (!settings.questions.length) { %><p class="hint mt-3">Questions par défaut : <%= effectiveQuestions.map((q) => q.label).join(' · ') %></p><% } %>
      </section>

      <section class="card">
        <h2 class="card-title">Review &amp; rôles</h2>
        <div class="field"><label for="wl-channel">Salon de review du staff</label><%- include('../partials/channel-select', { name: 'reviewChannelId', id: 'wl-channel', selected: settings.reviewChannelId || '', emptyLabel: '— Aucun (panel uniquement) —' }) %><small class="hint">Chaque candidature y est publiée avec les boutons Accepter / Refuser.</small></div>
        <div class="field-row mt-4">
          <div class="field"><label for="wl-accepted">Rôle donné si acceptée</label><%- include('../partials/role-select', { name: 'acceptedRoleId', id: 'wl-accepted', selected: settings.acceptedRoleId || '', multiple: false, emptyLabel: '— Aucun —' }) %></div>
          <div class="field"><label for="wl-pending">Rôle pendant l'attente</label><%- include('../partials/role-select', { name: 'pendingRoleId', id: 'wl-pending', selected: settings.pendingRoleId || '', multiple: false, emptyLabel: '— Aucun —' }) %></div>
        </div>
        <div class="toggle-list mt-4">
          <label class="toggle-row"><span class="toggle-row-text"><span class="toggle-row-title">Candidatures ouvertes</span><span class="toggle-row-hint">Fermées : <code>/whitelist</code> refuse les nouvelles candidatures.</span></span><span class="toggle"><input type="checkbox" name="enabled" <%= settings.enabled ? 'checked' : '' %>><span class="toggle-track"></span></span></label>
          <label class="toggle-row"><span class="toggle-row-text"><span class="toggle-row-title">Prévenir le candidat en DM</span><span class="toggle-row-hint">Message envoyé à la décision, avec la note du staff.</span></span><span class="toggle"><input type="checkbox" name="dmOnDecision" <%= settings.dmOnDecision ? 'checked' : '' %>><span class="toggle-track"></span></span></label>
        </div>
      </section>
      <div class="form-actions dirty-hide"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
    </div>

    <aside class="split-preview">
      <div class="preview-panel">
        <div class="preview-panel-head"><span class="row"><%- icon('eye', { size: 15 }) %>Formulaire /whitelist</span><span class="badge badge-muted">Discord</span></div>
        <div class="preview-panel-body"><div class="dmodal-stage" data-modal-live="#wl-questions" data-modal-title="<%= modalTitle %>" data-modal-fallback="#wl-default-questions"><%- discordPreview.renderModal({ title: modalTitle, fields: settings.questions.length ? settings.questions : effectiveQuestions }) %></div></div>
      </div>
      <div class="preview-panel">
        <div class="preview-panel-head"><span class="row"><%- icon('send', { size: 15 }) %>DM d'acceptation</span><span class="badge badge-muted">exemple de note</span></div>
        <div class="preview-panel-body"><%- dmPreviews.accepted %></div>
      </div>
    </aside>
  </form>
  <script type="application/json" id="wl-default-questions"><%- jsonScript(effectiveQuestions) %></script>
<% } %>
