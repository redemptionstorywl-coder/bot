<%
  const g = guild; const base = `/guilds/${g.id}`;
  const done = steps.filter((s) => s.done).length;
  const allDone = done === steps.length;
  const langLabel = overview.defaultLanguage === 'en' ? 'anglais' : 'français';
%>
<header class="page-header">
  <div class="overview-head">
    <% if (g.iconUrl) { %><img class="avatar avatar-lg" src="<%= g.iconUrl %>" alt=""><% } else { %><span class="avatar avatar-lg avatar-fallback avatar-square"><%= fmt.initials(g.name) %></span><% } %>
    <div class="min-w-0">
      <p class="eyebrow">Vue d'ensemble</p>
      <h1 class="page-title"><%= g.name %></h1>
      <p class="page-subtitle"><%= kindLabel(overview.kind) %> · bot en <%= langLabel %> · fuseau <%= config.timezone %></p>
    </div>
  </div>
  <div class="page-actions">
    <a class="btn" href="<%= base %>/logs"><%- icon('scroll-text', { size: 16 }) %>Logs</a>
    <a class="btn" href="<%= base %>/settings"><%- icon('settings', { size: 16 }) %>Paramètres</a>
  </div>
</header>

<% if (lockdown) { %>
  <div class="alert alert-danger" role="alert"><%- icon('lock') %><span class="alert-text"><span class="alert-title">Lockdown actif</span>Les membres hors staff ne peuvent plus écrire<%= lockdown.at ? ' depuis le ' + fmt.dateTime(lockdown.at) : '' %>. <a class="link" href="<%= base %>/moderation?tab=lockdown">Lever le lockdown</a></span></div>
<% } %>

<section class="stat-grid" aria-label="Chiffres clés" data-live-reload>
  <a class="stat" href="<%= base %>/members">
    <span class="stat-label">Membres</span>
    <strong class="stat-value" data-stat="members"><%= fmt.number(overview.members) %></strong>
    <span class="stat-sub"><% if (overview.online !== null) { %><span data-stat="online"><%= fmt.number(overview.online) %></span> en ligne<% } else { %>présences indisponibles<% } %></span>
  </a>
  <a class="stat" href="<%= base %>/tickets/list?status=open">
    <span class="stat-label">Tickets en attente</span>
    <strong class="stat-value" data-stat="openTickets"><%= fmt.number(overview.counts.openTickets) %></strong>
    <span class="stat-sub">ouverts ou pris en charge</span>
  </a>
  <a class="stat" href="<%= base %>/moderation">
    <span class="stat-label">Sanctions (7 j)</span>
    <strong class="stat-value" data-stat="sanctions7d"><%= fmt.number(overview.counts.sanctions7d) %></strong>
    <span class="stat-sub"><span data-stat="activeWarnings"><%= fmt.number(overview.counts.activeWarnings) %></span> avertissement(s) actif(s)</span>
  </a>
  <a class="stat" href="<%= base %>/settings#modules">
    <span class="stat-label">Modules actifs</span>
    <strong class="stat-value"><span data-stat="modules-active"><%= overview.modules.active %></span><span class="stat-sub">/ <%= overview.modules.total %></span></strong>
    <span class="stat-sub"><%= fmt.number(overview.roles) %> rôles · <%= fmt.number(overview.channels) %> salons</span>
  </a>
</section>

<div class="overview-grid">
  <div class="overview-main">
    <% if (!allDone) { %>
    <section class="setup" id="mise-en-route" aria-labelledby="setup-title">
      <div class="section-head">
        <div><h2 class="section-title" id="setup-title">Mise en route</h2><p>Les réglages essentiels, cochés automatiquement d'après la configuration du serveur.</p></div>
      </div>
      <div class="setup-progress"><span><strong><%= done %> sur <%= steps.length %></strong> terminées</span><span class="bar-track" aria-hidden="true"><span class="bar-fill" data-pct="<%= Math.round((done / steps.length) * 100) %>"></span></span></div>
      <ol class="setup-list">
        <% for (const s of steps) { %>
          <li class="setup-item<%= s.done ? ' is-done' : '' %>">
            <a href="<%= s.href %>">
              <span class="setup-state" aria-hidden="true"><%- icon('check') %></span>
              <span><span class="setup-title"><%= s.title %></span><span class="sr-only"><%= s.done ? ' (terminé)' : ' (à faire)' %></span><span class="setup-desc"><%= s.desc %></span></span>
              <span class="setup-go"><%= s.cta %><%- icon('arrow-right') %></span>
            </a>
          </li>
        <% } %>
      </ol>
    </section>
    <% } %>

    <section class="card" aria-label="Arrivées et départs">
      <%- include('../partials/chart-mirror', { chart: charts.members, title: 'Arrivées et départs', sub: '30 derniers jours, par jour (journal des membres).', emptyText: 'Aucune arrivée ni aucun départ enregistré sur 30 jours. Les données viennent des logs « Membres » : vérifiez que ce module de logs est actif.' }) %>
    </section>

    <section class="card" aria-label="Tickets">
      <%- include('../partials/chart-line', { chart: charts.tickets, title: 'Tickets ouverts et fermés', sub: '30 derniers jours, par jour.', emptyText: 'Aucun ticket ouvert ni fermé sur 30 jours.', extraFigure: { label: 'En attente', value: charts.backlog } }) %>
    </section>

    <section class="card" aria-label="Sanctions">
      <%- include('../partials/chart-hbars', { chart: charts.sanctions, title: 'Sanctions par type', sub: '30 derniers jours.', emptyText: 'Aucune sanction sur 30 jours.', unit: 'Sanctions' }) %>
    </section>
  </div>

  <aside class="overview-aside">
    <% if (allDone) { %>
      <p class="setup-done"><%- icon('check-circle') %>Mise en route terminée : les réglages essentiels sont en place.</p>
    <% } %>

    <section aria-labelledby="state-title">
      <div class="section-head"><h2 class="section-title" id="state-title">État</h2></div>
      <ul class="status-list">
        <li class="status-item"><span class="dot <%= botReady ? 'dot-success' : 'dot-warning' %>" aria-hidden="true"></span><span><%= botUser ? botUser.username : 'Bot' %> <%= botReady ? 'en ligne' : 'en démarrage' %></span><span class="status-value" data-stat="ping"><%= overview.pingMs >= 0 ? overview.pingMs + ' ms' : '—' %></span></li>
        <li class="status-item"><span class="dot <%= lockdown ? 'dot-danger' : 'dot-success' %>" aria-hidden="true"></span><span><%= lockdown ? 'Lockdown actif' : 'Serveur ouvert' %></span><a class="link text-xs" href="<%= base %>/moderation?tab=lockdown">Gérer</a></li>
        <% for (const s of servers) { %>
          <li class="status-item"><span class="dot <%= s.state === 'online' ? 'dot-success' : s.state === 'maintenance' ? 'dot-warning' : 'dot-danger' %>" aria-hidden="true"></span><span title="<%= s.name %>"><%= s.name %> <span class="text-3">· <%= s.stateLabel %></span></span><span class="status-value"><%= s.players %> / <%= s.maxPlayers || '—' %></span></li>
        <% } %>
      </ul>
    </section>

    <section aria-labelledby="activity-title">
      <div class="section-head"><h2 class="section-title" id="activity-title">Activité récente</h2><a class="link text-sm" href="<%= base %>/logs">Tout voir</a></div>
      <% if (!logs.length) { %>
        <%- include('../partials/empty', { glyph: 'activity', title: 'Aucune activité pour l’instant', text: 'Les actions du bot et du staff apparaîtront ici en temps réel.', compact: true }) %>
      <% } else { %>
      <ol class="timeline" id="recent-logs">
        <% for (const l of logs) { const p = l.actorId ? profiles[l.actorId] : null; %>
          <li class="timeline-item">
            <span class="log-icon"><%- icon(l.icon) %></span>
            <div class="grow">
              <div class="log-row-title"><%= l.title %></div>
              <div class="log-row-meta">
                <span><%= l.categoryLabel %></span>
                <% if (l.actorId) { %><span class="row"><% if (p) { %><img class="avatar avatar-xs" src="<%= p.avatarUrl %>" alt=""><% } %><%= p ? p.name : l.actorId %></span><% } %>
                <span title="<%= fmt.dateTime(l.createdAt) %>"><%= fmt.relative(l.createdAt) %></span>
                <code><%= l.action %></code>
              </div>
            </div>
          </li>
        <% } %>
      </ol>
      <% } %>
    </section>

    <section aria-labelledby="modules-title">
      <div class="section-head"><h2 class="section-title" id="modules-title">Modules</h2><a class="link text-sm" href="<%= base %>/settings#modules">Gérer</a></div>
      <ul class="module-chips" data-module-chips>
        <% for (const grp of moduleGroups) { for (const m of grp.modules) { %>
          <li class="chip <%= m.enabled ? 'chip-on' : 'chip-off' %>" data-module-chip="<%= m.key %>"><span class="chip-dot" aria-hidden="true"></span><%= m.label %></li>
        <% } } %>
      </ul>
    </section>
  </aside>
</div>
