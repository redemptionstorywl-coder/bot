<% const a = announcement; const isPublished = a && a.status === 'PUBLISHED'; const isArchived = a && a.status === 'ARCHIVED'; %>
<section class="page-header">
  <div>
    <a class="link" href="/guilds/<%= guild.id %>/announcements">← Retour aux annonces</a>
    <h2 class="page-title"><%= a ? a.title : 'Nouvelle annonce' %> <% if (a) { %><span class="badge badge-status-<%= a.status %>"><%= statusLabel %></span><% } %></h2>
    <p class="muted"><% if (a) { %>Créée le <%= fmt.dateTime(a.createdAt) %><% if (a.publishedAt) { %> · publiée le <%= fmt.dateTime(a.publishedAt) %><% } %><% if (pendingSchedule) { %> · programmée pour le <strong><%= fmt.dateTime(pendingSchedule.scheduledAt) %></strong><% } %><% } else { %>Rédigez l'annonce, choisissez son salon puis publiez ou programmez.<% } %></p>
  </div>
  <% if (a) { %>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/guilds/<%= guild.id %>/announcements/<%= a.id %>/preview">Aperçu</a>
    <form method="post" action="/guilds/<%= guild.id %>/announcements/<%= a.id %>/duplicate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost">Dupliquer</button></form>
    <% if (!isArchived) { %><form method="post" action="/guilds/<%= guild.id %>/announcements/<%= a.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost" data-confirm="Archiver cette annonce ? Les messages publiés sont conservés, la programmation annulée.">Archiver</button></form><% } %>
    <form method="post" action="/guilds/<%= guild.id %>/announcements/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Supprimer définitivement cette annonce et ses messages Discord ?">Supprimer</button></form>
  </div>
  <% } %>
</section>

<form method="post" action="/guilds/<%= guild.id %>/announcements<%= a ? '/' + a.id : '' %>" class="form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (isPublished) { %><div class="alert alert-info"><span class="alert-icon" aria-hidden="true">i</span><span class="alert-text">Cette annonce est publiée : enregistrer met à jour les messages Discord existants.</span></div><% } %>

  <div class="grid-2">
    <div class="card">
      <h3 class="card-title">Général</h3>
      <div class="field"><label for="a-title">Titre interne</label><input id="a-title" name="title" class="input" maxlength="190" required value="<%= a ? a.title : '' %>" placeholder="Nouvelle saison"></div>
      <div class="field"><label for="a-content">Texte au-dessus de l'embed</label><textarea id="a-content" name="content" class="textarea" rows="3" maxlength="2000" placeholder="Texte optionnel, variables acceptées"><%= a && a.content ? a.content : '' %></textarea></div>
      <div class="field"><label for="a-channel">Salon de publication</label><select id="a-channel" name="channelId" class="select"><%- include('../partials/channel-options', { channels: guild.textChannels, selected: a ? a.channelId : '', allowEmpty: true, emptyLabel: '— Choisir un salon —' }) %></select><small class="hint">Obligatoire pour publier ou programmer.</small></div>
    </div>
    <div class="card">
      <h3 class="card-title">Mentions</h3>
      <label class="check"><input type="checkbox" name="mentionEveryone" <%= a && a.mentionEveryone ? 'checked' : '' %>><span>Mentionner @everyone</span></label>
      <div class="field"><label for="a-roles">Rôles à mentionner</label><select id="a-roles" name="mentionRoleIds" class="select" multiple size="8" data-multi><%- include('../partials/role-options', { roles: guild.roles, selected: a ? a.mentionRoleIds : [] }) %></select></div>
    </div>
  </div>

  <div class="card">
    <h3 class="card-title">Embed</h3>
    <%- include('../partials/embed-editor', { prefix: 'embed', spec, id: 'ann-embed', buttons, buttonsName: 'buttonsJson', withPreview: true, withJson: true, contentSource: '#a-content' }) %>
  </div>

  <div class="form-actions sticky-actions">
    <a class="btn btn-ghost" href="/guilds/<%= guild.id %>/announcements">Annuler</a>
    <button type="submit" class="btn btn-primary"><%= a ? 'Enregistrer' : 'Créer le brouillon' %></button>
  </div>
</form>

<% if (a && !isArchived) { %>
<div class="grid-2">
  <div class="card">
    <h3 class="card-title">Publier maintenant</h3>
    <% if (!botReady) { %><div class="alert alert-warning"><span class="alert-icon" aria-hidden="true">⚠</span><span class="alert-text">Le bot n'est pas connecté : la publication est indisponible pour le moment.</span></div><% } %>
    <% if (isPublished) { %><p class="muted">Déjà publiée. Modifiez le contenu ci-dessus puis enregistrez pour synchroniser les messages.</p><% } else { %>
    <p class="muted">Envoie l'annonce dans le salon choisi. Les mentions sont incluses.</p>
    <form method="post" action="/guilds/<%= guild.id %>/announcements/<%= a.id %>/publish" data-confirm="Publier l'annonce « <%= a.title %> » maintenant ?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-primary" <%= botReady ? '' : 'disabled' %>>Publier</button></form>
    <% } %>
  </div>
  <div class="card">
    <h3 class="card-title">Programmer</h3>
    <% if (pendingSchedule) { %>
      <p>Programmée pour le <strong><%= fmt.dateTime(pendingSchedule.scheduledAt) %></strong> (<%= fmt.relative(pendingSchedule.scheduledAt) %>).</p>
      <form method="post" action="/guilds/<%= guild.id %>/announcements/<%= a.id %>/cancel-schedule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Annuler la programmation ?">Annuler la programmation</button></form>
    <% } else if (isPublished) { %><p class="muted">Une annonce publiée ne peut pas être reprogrammée : dupliquez-la.</p><% } else { %>
      <form method="post" action="/guilds/<%= guild.id %>/announcements/<%= a.id %>/schedule" class="inline-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="a-schedule">Date et heure (<%= timezone %>)</label><input id="a-schedule" type="datetime-local" name="scheduledAt" class="input" required min="<%= minSchedule %>" value="<%= minSchedule %>"></div>
        <div class="field field-fixed"><button type="submit" class="btn btn-primary">Programmer</button></div>
      </form>
    <% } %>
  </div>
</div>
<% } %>
