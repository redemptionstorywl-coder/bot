<section class="hero">
  <div class="hero-badge"><%- include('../partials/logo') %><span>Redemption Story Studio</span></div>
  <h1 class="hero-title">Pilotez votre bot Discord<br><span class="accent">depuis un seul tableau de bord</span></h1>
  <p class="hero-text">Tickets, modération, annonces, rôles, traductions, Battle Royale, School RP, Shop : configurez chaque module serveur par serveur, suivez les logs en temps réel et gérez vos communautés multilingues.</p>
  <div class="hero-actions">
    <% if (oauthConfigured) { %>
      <a class="btn btn-primary btn-lg" href="/auth/login"><span aria-hidden="true">🎮</span> Se connecter avec Discord</a>
    <% } else { %>
      <a class="btn btn-primary btn-lg" href="/auth/login">Configurer la connexion</a>
    <% } %>
    <a class="btn btn-ghost btn-lg" href="<%= inviteUrl %>" target="_blank" rel="noopener">Inviter le bot</a>
  </div>
  <% if (!oauthConfigured) { %>
    <div class="alert alert-warning hero-alert"><span class="alert-icon" aria-hidden="true">⚠</span><span class="alert-text">La connexion Discord n'est pas encore configurée (DISCORD_CLIENT_SECRET manquant).</span></div>
  <% } %>
</section>

<section class="stat-grid stat-grid-landing">
  <div class="stat-card"><span class="stat-label">Serveurs</span><strong class="stat-value"><%= fmt.number(stats.guilds) %></strong></div>
  <div class="stat-card"><span class="stat-label">Membres</span><strong class="stat-value"><%= fmt.number(stats.members) %></strong></div>
  <div class="stat-card"><span class="stat-label">Modules</span><strong class="stat-value"><%= stats.modules %></strong></div>
  <div class="stat-card"><span class="stat-label">Commandes</span><strong class="stat-value"><%= stats.commands %></strong></div>
</section>

<section class="feature-grid">
  <% const features = [
    ['🎫', 'Tickets', 'Panneaux, formulaires, transcripts et statistiques.'],
    ['🛡️', 'Modération', 'Sanctions, avertissements, anti-raid et historique complet.'],
    ['🌍', 'Multilingue', '10 langues, salons ou permissions par langue, overrides par serveur.'],
    ['📢', 'Annonces & embeds', 'Éditeur d’embeds, planification, publication multi-salons.'],
    ['🎭', 'Rôles', 'Auto-roles, menus de rôles, reaction roles et notifications.'],
    ['⚔️', 'FiveM', 'Battle Royale, School RP, whitelist et boutique connectés au jeu.'],
  ]; %>
  <% for (const [icon, name, text] of features) { %>
    <article class="card feature-card"><div class="feature-icon" aria-hidden="true"><%= icon %></div><h3><%= name %></h3><p><%= text %></p></article>
  <% } %>
</section>
