<section class="error-page">
  <div class="error-code" aria-hidden="true"><%= status %></div>
  <p class="eyebrow">Erreur <%= status %></p>
  <h1 class="error-title"><%= statusTitle %></h1>
  <p class="error-message"><%= message %></p>
  <% if (details && details.length) { %>
    <ul class="error-details"><% for (const d of details) { %><li><%= d %></li><% } %></ul>
  <% } %>
  <div class="error-actions">
    <a class="btn" href="<%= user ? '/guilds' : '/' %>" data-back><%- icon('arrow-left', { size: 16 }) %>Retour</a>
    <a class="btn btn-primary" href="<%= user ? '/guilds' : '/' %>"><%= user ? 'Mes serveurs' : "Accueil" %></a>
  </div>
</section>
