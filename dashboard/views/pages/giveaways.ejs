<% const b = `/guilds/${guild.id}/giveaways`; %>
<%- include('../partials/events-header', { etab: 'giveaways', counts, moduleOff: moduleEnabled ? '' : 'Le module Giveaways est désactivé : les boutons de participation ne répondent pas et les tirages automatiques sont suspendus.' }) %>

<h2 class="section-title">En cours <span class="tab-count"><%= active.length %></span></h2>
<% if (!active.length) { %>
  <div class="card"><%- include('../partials/empty', { glyph: 'gift', title: 'Aucun giveaway en cours', text: 'Lancez un tirage au sort avec conditions (rôle, messages) et fin automatique.', actionHref: b + '/new', actionLabel: 'Nouveau giveaway', actionIcon: 'plus', compact: true }) %></div>
<% } else { %>
  <div class="panel-list mb-5" data-live-reload>
    <% for (const g of active) { %>
      <article class="card giveaway-card mb-0">
        <div class="row justify-between">
          <a class="link strong truncate" href="<%= b %>/<%= g.id %>">🎁 <%= g.prize %></a>
          <span class="badge badge-status-ONGOING">En cours</span>
        </div>
        <div class="giveaway-metrics">
          <div><span class="text-xs text-3">Fin</span><strong title="<%= fmt.dateTime(g.endsAt) %>"><%= fmt.relative(g.endsAt) %></strong></div>
          <div><span class="text-xs text-3">Participants</span><strong><%= fmt.number(g.entries.length) %></strong></div>
          <div><span class="text-xs text-3">Gagnants</span><strong><%= g.winnersCount %></strong></div>
        </div>
        <div class="text-xs text-3 row-wrap"><span class="channel-tag"><%- icon('hash') %><%= channelName(g.channelId) %></span><% if (g.requiredRoleId) { %><span>· rôle <%= roleName(g.requiredRoleId) %></span><% } %><% if (g.minMessages) { %><span>· ≥ <%= g.minMessages %> messages</span><% } %></div>
        <div class="row">
          <a class="btn btn-sm" href="<%= b %>/<%= g.id %>"><%- icon('eye', { size: 14 }) %>Détails</a>
          <form method="post" action="<%= b %>/<%= g.id %>/end" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm" data-confirm="Terminer maintenant « <%= g.prize %> » et tirer les gagnants ?" data-confirm-label="Tirer au sort" data-confirm-variant="primary" <%= botReady ? '' : 'disabled' %>><%- icon('sparkles', { size: 14 }) %>Tirer maintenant</button></form>
          <form method="post" action="<%= b %>/<%= g.id %>/cancel" class="inline-form ml-auto"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="icon-btn is-danger" aria-label="Annuler le giveaway" data-tooltip="Annuler" data-confirm="Annuler « <%= g.prize %> » sans gagnant ?" data-confirm-label="Annuler le giveaway"><%- icon('x-circle', { size: 16 }) %></button></form>
        </div>
      </article>
    <% } %>
  </div>
<% } %>

<h2 class="section-title">Terminés <span class="tab-count"><%= ended.length %></span></h2>
<section class="card card-flush">
  <% if (!ended.length) { %>
    <%- include('../partials/empty', { glyph: 'archive', title: 'Aucun giveaway terminé', text: 'L’historique des tirages et des gagnants apparaîtra ici.', compact: true }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table table-responsive table-clickable">
      <thead><tr><th>Lot</th><th>Terminé</th><th class="right">Participants</th><th>Gagnants</th><th class="shrink"></th></tr></thead>
      <tbody>
        <% for (const g of ended) { const w = winnersOf(g); %>
          <tr data-href="<%= b %>/<%= g.id %>">
            <td class="cell-primary"><a class="link strong" href="<%= b %>/<%= g.id %>"><%= g.prize %></a></td>
            <td data-label="Terminé" class="nowrap text-2" title="<%= fmt.dateTime(g.endsAt) %>"><%= fmt.relative(g.endsAt) %></td>
            <td data-label="Participants" class="right"><%= fmt.number(g.entries.length) %></td>
            <td data-label="Gagnants"><% if (!w.length) { %><span class="text-3"><%= g.entries.length ? 'Aucun' : 'Annulé / aucun participant' %></span><% } else { %><div class="chip-group"><% for (const id of w) { %><span class="chip">🏆 <%= names[id] || id %></span><% } %></div><% } %></td>
            <td data-label="" class="right"><form method="post" action="<%= b %>/<%= g.id %>/reroll" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="count" value="1"><button type="submit" class="btn btn-sm" <%= g.entries.length && botReady ? '' : 'disabled' %> data-confirm="Tirer un nouveau gagnant pour « <%= g.prize %> » ? Les gagnants précédents sont exclus." data-confirm-label="Relancer" data-confirm-variant="primary"><%- icon('refresh', { size: 14 }) %>Relancer</button></form></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
