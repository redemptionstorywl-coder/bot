<% const base = `/guilds/${guild.id}`; %>
<header class="page-header">
  <div class="page-heading">
    <div><%- include('../partials/eyebrow') %><h1 class="page-title">Logs</h1><p class="page-subtitle">Historique des événements du serveur et salons Discord où le bot les publie.</p></div>
  </div>
</header>

<% if (hub && hub.linked) { %><div class="callout mb-4"><%- icon('layers') %><div>Les logs de ce serveur sont copiés dans le hub de logs <strong><%= hub.name %></strong><%= hub.keepLocal ? ' (et toujours publiés dans les salons ci-dessous)' : ' uniquement (plus publiés dans les salons ci-dessous)' %>. <a class="link" href="<%= base %>/log-hub">Gérer le lien</a></div></div><% } else if (hub) { %><div class="callout mb-4"><%- icon('layers') %><div>Ce serveur est un <strong>serveur de logs central</strong>. <a class="link" href="<%= base %>/log-hub">Ouvrir le hub de logs</a></div></div><% } %>
<% if (!moduleEnabled) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Logs est désactivé : rien n'est publié dans Discord (l'historique reste enregistré). <a class="link" href="<%= base %>/settings#modules">Activer le module</a></span></div><% } %>

<%- include('../partials/tabs', { active: tab, label: 'Sections des logs', tabs: [
  { key: 'history', label: 'Historique', href: base + '/logs', icon: 'list', count: fmt.number(pagination.total) },
  { key: 'channels', label: 'Salons de logs', href: base + '/logs?tab=channels', icon: 'hash', count: configured + '/' + categories.length },
] }) %>

<% if (tab === 'channels') { %>
<div class="grid-aside-right grid-2">
  <form method="post" action="<%= base %>/logs/channels" class="form" data-dirty-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <section class="card">
      <div class="card-head"><div><h2 class="card-title">Catégorie → salon</h2><p class="card-desc">Choisissez où chaque type d'événement est publié. Laissez vide pour ne pas publier.</p></div></div>
      <div class="log-map">
        <% for (const c of categories) { %>
          <div class="log-map-row">
            <div class="log-map-label"><span class="log-icon"><%- icon(c.icon) %></span><div class="grow"><label class="strong text-sm" for="log-<%= c.value %>"><%= c.label %></label><div class="text-xs text-3"><%= c.description %></div></div></div>
            <%- include('../partials/channel-select', { name: `channels[${c.value}]`, id: `log-${c.value}`, selected: c.channelId, emptyLabel: 'Non publié', placeholder: 'Non publié' }) %>
          </div>
        <% } %>
      </div>
      <div class="card-foot dirty-hide"><span></span><button type="submit" class="btn btn-primary">Enregistrer les salons</button></div>
    </section>
  </form>
  <aside class="stack">
    <form method="post" action="<%= base %>/logs/channels/all" class="card form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2 class="card-title"><%- icon('zap') %>Tout dans un salon</h2>
      <p class="card-desc mb-4">Envoie les <%= categories.length - 1 %> catégories dans un seul salon, en un clic (sauf Jeu : les logs en jeu ont besoin de leur propre salon).</p>
      <div class="field"><label for="all-channel">Salon</label><%- include('../partials/channel-select', { name: 'channelId', id: 'all-channel', selected: '', allowEmpty: true, emptyLabel: '— Choisir —', required: true }) %></div>
      <button type="submit" class="btn btn-block" data-confirm="Remplacer le salon de toutes les catégories par ce salon ?" data-confirm-title="Tout dans un salon" data-confirm-label="Appliquer" data-confirm-variant="primary">Appliquer à toutes les catégories</button>
    </form>
    <div class="callout"><%- icon('info') %><div>Le bot doit pouvoir <strong>voir</strong> le salon, y <strong>envoyer des messages</strong> et des <strong>embeds</strong>.</div></div>
  </aside>
</div>
<% } else { %>
<form method="get" action="<%= base %>/logs" class="card filter-bar">
  <div class="field"><label for="f-category">Catégorie</label>
    <select id="f-category" name="category" class="select">
      <option value="">Toutes</option>
      <% for (const c of categories) { %><option value="<%= c.value %>" <%= filters.category === c.value ? 'selected' : '' %>><%= c.label %></option><% } %>
    </select>
  </div>
  <div class="field"><label for="f-q">Recherche</label><label class="search"><%- icon('search', { size: 16 }) %><input id="f-q" name="q" class="input" value="<%= filters.q %>" placeholder="action (ex. ticket.open) ou ID"></label></div>
  <div class="field"><label for="f-from">Du</label><input id="f-from" name="from" type="date" class="input" value="<%= filters.from || '' %>"></div>
  <div class="field"><label for="f-to">Au</label><input id="f-to" name="to" type="date" class="input" value="<%= filters.to || '' %>"></div>
  <div class="field field-actions"><button type="submit" class="btn btn-primary"><%- icon('filter', { size: 16 }) %>Filtrer</button><% if (filters.category || filters.q || filters.from || filters.to) { %><a class="btn btn-ghost" href="<%= base %>/logs">Réinitialiser</a><% } %></div>
</form>

<section class="card card-flush mt-5" data-live-reload>
  <% if (!logs.length) { %>
    <%- include('../partials/empty', { glyph: 'scroll-text', title: 'Aucun log', text: filters.category || filters.q || filters.from || filters.to ? 'Aucun événement ne correspond à ces filtres.' : 'Les événements du serveur apparaîtront ici.' }) %>
  <% } else { %>
  <div class="table-wrap">
    <table class="table table-responsive">
      <thead><tr><th>Événement</th><th>Catégorie</th><th>Acteur</th><th>Cible</th><th>Date</th></tr></thead>
      <tbody>
        <% for (const l of logs) { const a = l.actorId ? profiles[l.actorId] : null; const t = l.targetId ? profiles[l.targetId] : null; %>
          <tr>
            <td class="cell-primary">
              <details class="log-details">
                <summary class="row-3"><span class="log-icon"><%- icon(l.icon) %></span><span><span class="log-row-title"><%= l.title %></span><br><code class="text-xs text-3"><%= l.action %></code></span></summary>
                <% if (l.data) { %><pre class="json"><%= fmt.json(l.data) %></pre><% } %>
              </details>
            </td>
            <td data-label="Catégorie"><span class="badge badge-muted"><%= l.categoryLabel %></span></td>
            <td data-label="Acteur"><% if (l.actorId) { %><a class="user-cell" href="<%= base %>/members/<%= l.actorId %>"><% if (a) { %><img class="avatar avatar-xs" src="<%= a.avatarUrl %>" alt=""><% } %><span class="truncate"><%= a ? a.name : l.actorId %></span></a><% } else { %><span class="text-3">Système</span><% } %></td>
            <td data-label="Cible"><% if (l.targetId) { %><a class="user-cell" href="<%= base %>/members/<%= l.targetId %>"><% if (t) { %><img class="avatar avatar-xs" src="<%= t.avatarUrl %>" alt=""><% } %><span class="truncate"><%= t ? t.name : l.targetId %></span></a><% } else { %><span class="text-3">—</span><% } %></td>
            <td data-label="Date" class="nowrap"><span title="<%= fmt.dateTime(l.createdAt) %>"><%= fmt.relative(l.createdAt) %></span></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/pagination', { pagination, baseQuery, baseUrl: `${base}/logs` }) %>
<% } %>
