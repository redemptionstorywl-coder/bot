<% const p = poll; const b = `/guilds/${guild.id}/events`; const maxCount = Math.max(0, ...results.counts); %>
<a class="back-link" href="<%= b %>?tab=polls"><%- icon('arrow-left', { size: 16 }) %>Sondages</a>
<header class="page-header">
  <div class="page-heading">
    <span class="page-icon"><%- icon('bar-chart') %></span>
    <div>
      <h1 class="page-title row-wrap"><span><%= p.question %></span><span class="badge <%= p.ended ? 'badge-status-ENDED' : 'badge-status-ONGOING' %>"><%= p.ended ? 'Terminé' : 'Ouvert' %></span></h1>
      <p class="page-subtitle">Par <%= names[p.createdById] || p.createdById %> · #<%= channelName %> · <%= p.type === 'YES_NO' ? 'Oui / Non' : 'Options' %><%= p.multiSelect ? ' · plusieurs réponses' : '' %><%= p.anonymous ? ' · anonyme' : '' %><% if (p.endsAt) { %> · <%= p.ended ? 'terminé le' : 'fin' %> <%= p.ended ? fmt.dateTime(p.endsAt) : fmt.relative(p.endsAt) %><% } %></p>
    </div>
  </div>
  <div class="page-actions">
    <% if (p.messageId) { %><a class="btn" href="https://discord.com/channels/<%= guild.id %>/<%= p.channelId %>/<%= p.messageId %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link', { size: 16 }) %>Voir sur Discord</a><% } %>
    <% if (!p.ended) { %><form method="post" action="<%= b %>/polls/<%= p.id %>/end" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Terminer ce sondage maintenant ? Les votes seront figés." data-confirm-label="Terminer"><%- icon('lock', { size: 16 }) %>Terminer</button></form><% } %>
  </div>
</header>

<div class="split" data-live-reload>
  <div class="stack">
    <div class="stat-grid mb-0">
      <div class="stat"><span class="stat-label">Votants</span><span class="stat-value"><%= fmt.number(results.voters) %></span></div>
      <div class="stat"><span class="stat-label">Voix</span><span class="stat-value"><%= fmt.number(results.total) %></span></div>
      <div class="stat"><span class="stat-label">En tête</span><span class="stat-value stat-value-sm truncate"><%= maxCount ? options.filter((o, i) => results.counts[i] === maxCount).map((o) => o.label).join(' / ') : '—' %></span></div>
    </div>

    <section class="card poll-results">
      <h2 class="card-title">Résultats</h2>
      <ul class="bars">
        <% for (let i = 0; i < options.length; i++) { const lead = maxCount && results.counts[i] === maxCount; %>
          <li class="bar-row">
            <span class="bar-label"><span class="truncate"><%= options[i].emoji ? options[i].emoji + ' ' : '' %><%= options[i].label %></span></span>
            <span class="bar-track"><span class="bar-fill<%= lead ? '' : ' is-muted' %>" data-pct="<%= results.percentages[i] %>"></span></span>
            <span class="bar-value"><%= results.percentages[i] %> % · <%= fmt.number(results.counts[i]) %></span>
          </li>
        <% } %>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">Votants par option</h2>
      <% if (!voters) { %>
        <p class="text-sm text-3"><%- icon('lock', { size: 14 }) %> Sondage anonyme : la liste des votants n'est pas conservée.</p>
      <% } else { %>
        <div class="grid-2">
          <% for (let i = 0; i < options.length; i++) { %>
            <div>
              <div class="row mb-3"><strong class="truncate"><%= options[i].emoji ? options[i].emoji + ' ' : '' %><%= options[i].label %></strong><span class="tab-count"><%= voters[i].length %></span></div>
              <% if (!voters[i].length) { %><p class="text-sm text-3">Aucun vote.</p><% } else { %>
                <div class="chip-group"><% for (const id of voters[i]) { %><a class="chip" href="/guilds/<%= guild.id %>/members/<%= id %>"><%= names[id] || id %></a><% } %></div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
  </div>

  <aside class="split-preview">
    <div class="preview-panel">
      <div class="preview-panel-head"><span class="row"><%- icon('eye', { size: 15 }) %>Message sur Discord</span><span class="badge badge-muted">#<%= channelName %></span></div>
      <div class="preview-panel-body"><%- previewHtml %></div>
    </div>
  </aside>
</div>
