<% const e = event; const editable = !e || e.status === 'SCHEDULED' || e.status === 'ONGOING'; %>
<section class="page-header">
  <div>
    <a class="link" href="/guilds/<%= guild.id %>/events">← Retour aux événements</a>
    <h2 class="page-title"><%= e ? e.name : 'Nouvel événement' %> <% if (e) { %><span class="badge badge-status-<%= e.status %>"><%= statusLabels[e.status] %></span><% } %></h2>
    <p class="muted"><% if (e) { %>Créé par <%= names[e.createdById] || e.createdById %> · #<%= channelName %><% if (e.messageId) { %> · <a class="link" href="https://discord.com/channels/<%= guild.id %>/<%= e.channelId %>/<%= e.messageId %>" target="_blank" rel="noopener noreferrer">message ↗</a><% } %><% if (remindersSent.length) { %> · rappels envoyés : <%= remindersSent.join(', ') %> min<% } %><% } else { %>L'événement est publié immédiatement dans le salon choisi avec un bouton d'inscription.<% } %></p>
  </div>
  <% if (e && editable) { %>
  <div class="page-actions">
    <form method="post" action="/guilds/<%= guild.id %>/events/<%= e.id %>/remind"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost" data-confirm="Envoyer un rappel maintenant (salon + DM des participants) ?" <%= botReady ? '' : 'disabled' %>>Envoyer un rappel</button></form>
    <form method="post" action="/guilds/<%= guild.id %>/events/<%= e.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger" data-confirm="Annuler cet événement ? Les participants seront prévenus en DM.">Annuler l'événement</button></form>
  </div>
  <% } %>
</section>

<div class="grid-2 grid-2-aside">
  <aside class="stack">
    <% if (e) { %>
    <section class="card">
      <div class="card-head"><h3 class="card-title">Participants</h3><span class="badge badge-muted"><%= e.participants.length %><%= e.maxParticipants ? ' / ' + e.maxParticipants : '' %></span></div>
      <% if (!e.participants.length) { %><p class="muted">Aucun inscrit pour le moment.</p><% } else { %>
      <div class="participant-grid"><% for (const p of e.participants) { %><a class="badge" href="/guilds/<%= guild.id %>/members/<%= p.userId %>" title="inscrit le <%= fmt.dateTime(p.joinedAt) %>"><%= names[p.userId] || p.userId %></a><% } %></div>
      <% } %>
    </section>
    <% } %>
    <section class="card card-muted">
      <h3 class="card-title">Rappels</h3>
      <p class="muted">Minutes avant le début, séparées par des virgules (ex. <code>1440, 60, 30, 10, 5</code>). Un rappel est envoyé dans le salon et en DM aux inscrits.</p>
    </section>
  </aside>

  <form method="post" action="/guilds/<%= guild.id %>/events<%= e ? '/' + e.id : '' %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card">
      <% if (!editable) { %><div class="alert alert-info"><span class="alert-icon" aria-hidden="true">i</span><span class="alert-text">Événement <%= statusLabels[e.status].toLowerCase() %> : lecture seule.</span></div><% } %>
      <% if (!e && !botReady) { %><div class="alert alert-warning"><span class="alert-icon" aria-hidden="true">⚠</span><span class="alert-text">Le bot n'est pas connecté : la publication est indisponible.</span></div><% } %>
      <fieldset <%= editable ? '' : 'disabled' %> class="field">
        <div class="field"><label for="ev-name">Nom</label><input id="ev-name" name="name" class="input" maxlength="190" required value="<%= e ? e.name : '' %>" placeholder="Soirée RP"></div>
        <div class="field"><label for="ev-description">Description</label><textarea id="ev-description" name="description" class="textarea" rows="5" maxlength="4000" required><%= e ? e.description : '' %></textarea></div>
        <div class="grid-2 grid-tight">
          <div class="field"><label for="ev-starts">Début (<%= timezone %>)</label><input id="ev-starts" name="startsAt" type="datetime-local" class="input" required value="<%= startsAtValue %>"></div>
          <div class="field"><label for="ev-ends">Fin (optionnelle)</label><input id="ev-ends" name="endsAt" type="datetime-local" class="input" value="<%= endsAtValue %>"></div>
        </div>
        <div class="grid-2 grid-tight">
          <div class="field"><label for="ev-location">Lieu</label><input id="ev-location" name="location" class="input" maxlength="200" value="<%= e && e.location ? e.location : '' %>" placeholder="Salon vocal, serveur FiveM…"></div>
          <div class="field"><label for="ev-image">Image (URL)</label><input id="ev-image" name="imageUrl" type="url" class="input" maxlength="500" value="<%= e && e.imageUrl ? e.imageUrl : '' %>"></div>
        </div>
        <div class="grid-3 grid-tight">
          <div class="field"><label for="ev-role">Rôle à mentionner</label><select id="ev-role" name="mentionRoleId" class="select"><option value="">— Aucun —</option><%- include('../partials/role-options', { roles: guild.roles, selected: e ? e.mentionRoleId || '' : '' }) %></select></div>
          <div class="field"><label for="ev-max">Participants max</label><input id="ev-max" name="maxParticipants" type="number" class="input" min="1" max="10000" value="<%= e && e.maxParticipants ? e.maxParticipants : '' %>" placeholder="illimité"></div>
          <div class="field"><label for="ev-lang">Langue</label><select id="ev-lang" name="language" class="select"><option value="">Langue du serveur</option><% for (const l of languages) { %><option value="<%= l.code %>" <%= e && e.language === l.code ? 'selected' : '' %>><%= l.flag %> <%= l.nativeLabel %></option><% } %></select></div>
        </div>
        <div class="grid-2 grid-tight">
          <% if (!e) { %><div class="field"><label for="ev-channel">Salon de publication</label><select id="ev-channel" name="channelId" class="select" required><%- include('../partials/channel-options', { channels: guild.textChannels, selected: '', allowEmpty: true, emptyLabel: '— Choisir —' }) %></select></div><% } %>
          <div class="field"><label for="ev-reminders">Rappels (minutes avant)</label><input id="ev-reminders" name="reminderOffsets" class="input input-mono" value="<%= reminderValue %>" placeholder="1440, 60, 30, 10, 5"></div>
        </div>
      </fieldset>
      <% if (editable) { %><div class="form-actions"><a class="btn btn-ghost" href="/guilds/<%= guild.id %>/events">Annuler</a><button type="submit" class="btn btn-primary" <%= !e && !botReady ? 'disabled' : '' %>><%= e ? 'Enregistrer' : 'Publier l’événement' %></button></div><% } %>
    </div>
  </form>
</div>
