<div class="modal" id="confirm-modal" hidden role="dialog" aria-modal="true" aria-labelledby="confirm-title">
  <div class="modal-backdrop" data-modal-cancel></div>
  <div class="modal-card">
    <h2 class="modal-title" id="confirm-title">Confirmer l'action</h2>
    <p class="modal-text" data-modal-text>Cette action est irréversible.</p>
    <div class="modal-actions">
      <button type="button" class="btn btn-ghost" data-modal-cancel>Annuler</button>
      <button type="button" class="btn btn-danger" data-modal-confirm>Confirmer</button>
    </div>
  </div>
</div>
