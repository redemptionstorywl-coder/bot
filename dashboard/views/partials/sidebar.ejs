<%
  const _sb = buildSidebar(guild.id, page, config ? config.modules : null);
  const _section = (currentPath.match(/^\/guilds\/\d+\/([a-z-]+)/) || [])[1] || '';
%>
<aside class="sidebar" id="sidebar" aria-label="Navigation principale">
  <div class="sidebar-head">
    <div class="dropdown grow" data-dropdown>
      <button type="button" class="guild-switch" data-dropdown-toggle aria-haspopup="menu" aria-expanded="false" aria-label="Changer de serveur (actuel : <%= guild.name %>)">
        <% if (guild.iconUrl) { %><img class="guild-switch-icon" src="<%= guild.iconUrl %>" alt=""><% } else { %><span class="guild-switch-icon avatar avatar-fallback"><%= fmt.initials(guild.name) %></span><% } %>
        <span class="guild-switch-text"><span class="guild-switch-name truncate"><%= guild.name %></span><span class="guild-switch-sub"><%= fmt.number(guild.memberCount) %> membres</span></span>
        <%- icon('chevrons-up-down', { size: 16 }) %>
      </button>
      <div class="dropdown-menu full" role="menu">
        <div class="dropdown-label">Vos serveurs</div>
        <% for (const g of switcherGuilds) { %>
          <a class="dropdown-item<%= g.id === guild.id ? ' is-active' : '' %>" role="menuitem" href="/guilds/<%= g.id %><%= _section ? '/' + _section : '' %>">
            <% if (g.iconUrl) { %><img src="<%= g.iconUrl %>" alt=""><% } else { %><span class="avatar avatar-xs avatar-fallback avatar-square"><%= fmt.initials(g.name) %></span><% } %>
            <span class="truncate"><%= g.name %></span>
            <% if (g.id === guild.id) { %><%- icon('check', { size: 16, cls: 'check-mark' }) %><% } %>
          </a>
        <% } %>
        <div class="dropdown-sep"></div>
        <a class="dropdown-item" role="menuitem" href="/guilds"><%- icon('server', { size: 16 }) %>Tous les serveurs</a>
        <a class="dropdown-item" role="menuitem" href="<%= inviteUrl %>" target="_blank" rel="noopener"><%- icon('plus', { size: 16 }) %>Ajouter le bot à un serveur</a>
      </div>
    </div>
    <button type="button" class="icon-btn sidebar-close" data-sidebar-close aria-label="Fermer le menu"><%- icon('x') %></button>
  </div>

  <nav class="sidebar-nav" aria-label="Sections du serveur">
    <% for (const group of _sb.groups) { %>
      <div class="nav-group">
        <% if (group.label) { %><div class="nav-group-label"><%= group.label %></div><% } %>
        <% for (const item of group.items) { %>
          <a href="<%= item.href %>" class="nav-item<%= item.active ? ' active' : '' %><%= item.dimmed ? ' is-dim' : '' %>"<%- item.active ? ' aria-current="page"' : '' %><%- item.dimmed ? ' title="Module désactivé"' : '' %>>
            <%- icon(item.icon) %><span class="nav-label"><%= item.label %></span>
          </a>
        <% } %>
      </div>
    <% } %>
    <% if (_sb.others.length) { %>
      <details class="nav-more"<%= _sb.othersOpen ? ' open' : '' %>>
        <summary><%- icon('chevron-right', { size: 14 }) %>Autres modules</summary>
        <% for (const item of _sb.others) { %>
          <a href="<%= item.href %>" class="nav-item is-dim<%= item.active ? ' active' : '' %>"<%- item.active ? ' aria-current="page"' : '' %> title="Module désactivé">
            <%- icon(item.icon) %><span class="nav-label"><%= item.label %></span>
          </a>
        <% } %>
      </details>
    <% } %>
  </nav>

  <div class="sidebar-foot">
    <%- include('user-menu', { menuClass: 'align-up full' }) %>
  </div>
</aside>
