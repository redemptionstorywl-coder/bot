<%#
  Aperçu d'un message Discord (rendu serveur — même moteur que le JS : public/js/discord-preview.js).
  Attend : embed (EmbedSpec | null), buttons (ButtonSpec[]), content (string), compact (bool),
           components ([{ type: 'select', placeholder, options, open } | { type: 'buttons', buttons }]), ephemeral (bool).
%><%- discordPreview.render({
  content: typeof content === 'string' ? content : '',
  embed: typeof embed !== 'undefined' && embed ? embed : null,
  buttons: typeof buttons !== 'undefined' && Array.isArray(buttons) ? buttons : [],
  components: typeof components !== 'undefined' && Array.isArray(components) ? components : [],
  compact: typeof compact !== 'undefined' && compact,
  ephemeral: typeof ephemeral !== 'undefined' && ephemeral,
}, previewContext()) %>
