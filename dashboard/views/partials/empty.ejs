<%#
  État vide. Attend : glyph (nom d'icône), title, text (optionnel), actionHref + actionLabel (+ actionIcon) optionnels, compact (bool).
%>
<div class="empty<%= typeof compact !== 'undefined' && compact ? ' empty-compact' : '' %>">
  <span class="empty-mark" aria-hidden="true"><%- icon(typeof glyph === 'string' ? glyph : 'inbox') %></span>
  <div class="empty-title"><%= typeof title === 'string' ? title : 'Rien à afficher' %></div>
  <% if (typeof text === 'string' && text) { %><p class="empty-text"><%= text %></p><% } %>
  <% if (typeof actionHref === 'string' && actionHref) { %>
    <div class="empty-actions"><a class="btn btn-primary btn-sm" href="<%= actionHref %>"><%- icon(typeof actionIcon === 'string' ? actionIcon : 'plus', { size: 16 }) %><%= actionLabel %></a></div>
  <% } %>
</div>
