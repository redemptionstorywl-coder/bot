<header class="topbar">
  <div class="topbar-left">
    <% if (user) { %>
    <button type="button" class="icon-btn sidebar-toggle" data-sidebar-toggle aria-label="Ouvrir le menu" aria-controls="sidebar">☰</button>
    <% } else { %>
    <a href="/" class="brand-link brand-link-top"><span class="brand-mark" aria-hidden="true"><%- include('logo') %></span><span class="brand-name">Redemption Story Studio</span></a>
    <% } %>
    <% if (typeof title === 'string' && title && user) { %><h1 class="topbar-title"><%= title %></h1><% } %>
  </div>
  <div class="topbar-right">
    <% if (user && switcherGuilds.length) { %>
    <label class="guild-switcher">
      <span class="sr-only">Changer de serveur</span>
      <select data-guild-switcher data-template="<%= page && page !== 'guilds' && page !== 'admin' && page !== 'home' && currentPath.startsWith('/guilds/') ? currentPath.replace(/^\/guilds\/\d+/, '/guilds/{id}') : '/guilds/{id}' %>">
        <option value="" <%= !guild ? 'selected' : '' %>>Choisir un serveur…</option>
        <% for (const g of switcherGuilds) { %>
          <option value="<%= g.id %>" <%= guild && guild.id === g.id ? 'selected' : '' %>><%= g.name %></option>
        <% } %>
      </select>
    </label>
    <% } %>
    <% if (user) { %>
      <span class="status-pill <%= botReady ? 'ok' : 'warn' %>" title="<%= botReady ? 'Bot connecté' : 'Bot en cours de démarrage' %>"><span class="status-dot"></span><%= botReady ? 'En ligne' : 'Démarrage' %></span>
    <% } else { %>
      <a class="btn btn-primary btn-sm" href="/auth/login">Se connecter avec Discord</a>
    <% } %>
  </div>
</header>
