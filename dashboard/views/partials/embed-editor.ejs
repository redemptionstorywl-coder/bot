<%#
  Éditeur d'embed complet (public/js/embed-editor.js). Les champs sont nommés `<prefix>[clé]`.
  Attend : prefix (ex. 'embed'), spec (EmbedSpec), id (identifiant unique sans crochets),
           buttons (ButtonSpec[] | null → pas de section boutons), buttonsName (nom du champ caché des boutons),
           withPreview (bool, défaut true), contentSource (sélecteur CSS d'un textarea de contenu à afficher dans l'aperçu),
           withJson (bool, import/export JSON côté client, défaut true), compact (bool : sections avancées repliées),
           withFields (bool, défaut true), previewTarget (sélecteur d'un hôte d'aperçu externe, avec withPreview: false).
  L'éditeur expose element.embedEditor = { load(spec, buttons), read(), readButtons(), render() } et émet `embed:change`.
%>
<%
  const _spec = spec || {};
  const _id = id;
  const _buttons = typeof buttons === 'undefined' ? null : buttons;
  const _preview = typeof withPreview === 'undefined' ? true : withPreview;
  const _json = typeof withJson === 'undefined' ? true : withJson;
  const _fields = typeof withFields === 'undefined' ? true : withFields;
  const _compact = typeof compact !== 'undefined' && compact;
  const n = (k) => `${prefix}[${k}]`;
%>
<div class="embed-editor<%= _preview ? ' has-preview' : '' %>" data-embed-editor <%- typeof contentSource === 'string' ? `data-content-source="${contentSource}"` : '' %> <%- typeof previewTarget === 'string' ? `data-preview-target="${previewTarget}"` : '' %> data-default-color="<%= config && config.brandColor !== undefined ? fmt.hex(config.brandColor) : '#7C3AED' %>">
  <div class="embed-editor-form">
    <div class="field-row">
      <div class="field"><label for="<%= _id %>-title">Titre</label><input id="<%= _id %>-title" class="input" name="<%= n('title') %>" data-embed-key="title" maxlength="256" value="<%= _spec.title || '' %>" placeholder="Titre de l'embed"></div>
      <div class="field"><label for="<%= _id %>-url">Lien du titre <span class="field-optional">optionnel</span></label><input id="<%= _id %>-url" class="input" type="url" name="<%= n('url') %>" data-embed-key="url" maxlength="2048" value="<%= _spec.url || '' %>" placeholder="https://…"></div>
    </div>
    <div class="field mt-4"><label for="<%= _id %>-description">Description</label><textarea id="<%= _id %>-description" class="textarea" name="<%= n('description') %>" data-embed-key="description" maxlength="4096" rows="5" placeholder="**Gras**, *italique*, `code`, [lien](https://…), variables {user}…"><%= _spec.description || '' %></textarea><small class="hint">Markdown Discord et variables (<code>{user}</code>, <code>{server}</code>…) acceptés.</small></div>
    <div class="field-row">
      <div class="field"><label for="<%= _id %>-color">Couleur</label><%- include('color-field', { name: n('color'), id: `${_id}-color`, value: _spec.color || '', allowEmpty: true, placeholder: 'Par défaut', dataKey: 'color' }) %></div>
      <div class="field"><span class="field-label">Horodatage</span><label class="toggle mt-2"><input type="checkbox" name="<%= n('timestamp') %>" data-embed-key="timestamp" <%= _spec.timestamp ? 'checked' : '' %>><span class="toggle-track"></span><span class="toggle-label">Afficher la date d'envoi</span></label></div>
    </div>
    <div class="field-row mt-4">
      <div class="field"><label for="<%= _id %>-image">Image <span class="field-optional">URL</span></label><input id="<%= _id %>-image" class="input" type="url" name="<%= n('image') %>" data-embed-key="image" maxlength="2048" value="<%= _spec.image || '' %>" placeholder="https://…"></div>
      <div class="field"><label for="<%= _id %>-thumbnail">Miniature <span class="field-optional">URL</span></label><input id="<%= _id %>-thumbnail" class="input" type="url" name="<%= n('thumbnail') %>" data-embed-key="thumbnail" maxlength="2048" value="<%= _spec.thumbnail || '' %>" placeholder="https://…"></div>
    </div>
    <details class="editor-section mt-4" <%= !_compact || (_spec.author && _spec.author.name) || (_spec.footer && _spec.footer.text) ? 'open' : '' %>>
      <summary>Auteur &amp; pied de page</summary>
      <div class="field-row">
        <div class="field"><label for="<%= _id %>-authorName">Nom de l'auteur</label><input id="<%= _id %>-authorName" class="input" name="<%= n('authorName') %>" data-embed-key="authorName" maxlength="256" value="<%= _spec.author ? _spec.author.name || '' : '' %>"></div>
        <div class="field"><label for="<%= _id %>-authorIconUrl">Icône de l'auteur</label><input id="<%= _id %>-authorIconUrl" class="input" type="url" name="<%= n('authorIconUrl') %>" data-embed-key="authorIconUrl" maxlength="2048" value="<%= _spec.author ? _spec.author.iconUrl || '' : '' %>" placeholder="https://…"></div>
        <div class="field"><label for="<%= _id %>-authorUrl">Lien de l'auteur</label><input id="<%= _id %>-authorUrl" class="input" type="url" name="<%= n('authorUrl') %>" data-embed-key="authorUrl" maxlength="2048" value="<%= _spec.author ? _spec.author.url || '' : '' %>" placeholder="https://…"></div>
      </div>
      <div class="field-row">
        <div class="field"><label for="<%= _id %>-footerText">Texte du pied de page</label><input id="<%= _id %>-footerText" class="input" name="<%= n('footerText') %>" data-embed-key="footerText" maxlength="2048" value="<%= _spec.footer ? _spec.footer.text || '' : '' %>"></div>
        <div class="field"><label for="<%= _id %>-footerIconUrl">Icône du pied de page</label><input id="<%= _id %>-footerIconUrl" class="input" type="url" name="<%= n('footerIconUrl') %>" data-embed-key="footerIconUrl" maxlength="2048" value="<%= _spec.footer ? _spec.footer.iconUrl || '' : '' %>" placeholder="https://…"></div>
      </div>
    </details>
    <% if (_fields) { %>
    <details class="editor-section" <%= !_compact || (_spec.fields || []).length ? 'open' : '' %>>
      <summary><span>Champs (<span data-fields-count><%= (_spec.fields || []).length %></span>/25)</span></summary>
      <div data-embed-fields><%- include('repeater', { kind: 'field', rows: _spec.fields || [], name: n('fieldsJson'), id: `${_id}-fields`, max: 25, addLabel: 'Ajouter un champ' }) %></div>
    </details>
    <% } %>
    <% if (_buttons !== null) { %>
    <details class="editor-section" open>
      <summary>Boutons (max 25)</summary>
      <div data-embed-buttons><%- include('repeater', { kind: 'button', rows: _buttons, name: typeof buttonsName === 'string' ? buttonsName : 'buttonsJson', id: `${_id}-buttons`, max: 25, addLabel: 'Ajouter un bouton' }) %></div>
      <small class="hint">Un bouton « Lien » requiert une URL ; les autres styles requièrent un identifiant interne (<code>namespace:args</code>).</small>
    </details>
    <% } %>
    <% if (_json) { %>
    <details class="editor-section">
      <summary>Importer / exporter JSON</summary>
      <textarea class="textarea textarea-sm input-mono" rows="6" data-embed-json placeholder='{"title": "…", "description": "…"}' aria-label="JSON de l'embed"></textarea>
      <div class="card-actions">
        <button type="button" class="btn btn-sm" data-embed-import><%- icon('upload', { size: 14 }) %>Appliquer le JSON</button>
        <button type="button" class="btn btn-sm" data-embed-export><%- icon('download', { size: 14 }) %>Exporter en JSON</button>
      </div>
      <small class="hint" data-embed-json-status></small>
    </details>
    <% } %>
  </div>
  <% if (_preview) { %>
  <div class="embed-editor-preview">
    <div class="preview-panel">
      <div class="preview-panel-head"><span class="row"><%- icon('eye', { size: 15 }) %>Aperçu en direct</span><span class="badge badge-muted">Discord</span></div>
      <div class="preview-panel-body" data-embed-preview><%- include('embed-preview', { embed: _spec, buttons: _buttons || [], content: '' }) %></div>
    </div>
  </div>
  <% } %>
</div>
