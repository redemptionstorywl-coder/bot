<%#
  En-tête commun des pages Tickets : titre, actions, avertissement module, onglets.
  Attend : tab ('reasons' | 'panels' | 'reminders' | 'list' | 'stats'), counts ({ reasons, panels, open }), moduleEnabled (optionnel).
%>
<% const _b = `/guilds/${guild.id}/tickets`; %>
<header class="page-header">
  <div class="page-heading">
    <div><%- include('eyebrow') %><h1 class="page-title">Tickets</h1><p class="page-subtitle">Support privé : raisons, formulaires, panneaux d'ouverture, relances et suivi.</p></div>
  </div>
  <div class="page-actions">
    <% if (tab === 'reasons') { %><a class="btn btn-primary" href="<%= _b %>/reasons/new"><%- icon('plus', { size: 16 }) %>Nouvelle raison</a><% } %>
    <% if (tab === 'panels') { %><a class="btn" href="<%= _b %>"><%- icon('list', { size: 16 }) %>Gérer les raisons</a><% } %>
    <% if (tab === 'list' || tab === 'stats') { %><a class="btn" href="<%= _b %>/panels"><%- icon('send', { size: 16 }) %>Publier un panneau</a><% } %>
  </div>
</header>
<% if (config && !config.modules.tickets) { %><div class="alert alert-warning"><%- icon('alert-triangle') %><span class="alert-text">Le module Tickets est désactivé : les panneaux et commandes ne répondent pas. <a class="link" href="/guilds/<%= guild.id %>/settings#modules">Activer le module</a></span></div><% } %>
<%- include('tabs', { active: tab, label: 'Sections des tickets', tabs: [
  { key: 'reasons', label: 'Raisons', href: _b, icon: 'list', count: counts.reasons },
  { key: 'panels', label: 'Panneaux', href: _b + '/panels', icon: 'send', count: counts.panels },
  { key: 'reminders', label: 'Relances', href: _b + '/reminders', icon: 'bell' },
  { key: 'list', label: 'Tickets', href: _b + '/list', icon: 'inbox', count: counts.open ? counts.open + ' ouverts' : null },
  { key: 'stats', label: 'Statistiques', href: _b + '/stats', icon: 'bar-chart' },
] }) %>
